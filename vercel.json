{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/shop/dos-and-donts",
      "destination": "/shop/meltdown-scripts/",
      "permanent": true
    },
    {
      "source": "/shop/dos-and-donts/",
      "destination": "/shop/meltdown-scripts/",
      "permanent": true
    },
    {
      "source": "/shop/coloring-book",
      "destination": "/shop/colouring-pack/",
      "permanent": true
    },
    {
      "source": "/shop/coloring-book/",
      "destination": "/shop/colouring-pack/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
