---
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__brand">
      <p class="foot__word"><img class="foot__mark" src="/brand/blu-mark.webp" alt="" width="36" height="36" loading="lazy" />Blu Baby Show</p>
      <p class="foot__tag">Every episode teaches feelings before it teaches facts.</p>
      <div class="foot__social">
        <a href="https://www.instagram.com/theblubabyshow/" target="_blank" rel="noopener">Instagram @theblubabyshow</a>
        <a href="https://www.youtube.com/@blubabyshow" target="_blank" rel="noopener">YouTube</a>
      </div>
    </div>

    <nav class="foot__col" aria-label="Explore">
      <span class="foot__h">Explore</span>
      <a href="/#watch">Watch</a>
      <a href="/kits/">Blu Kits</a>
      <a href="/shop/">Shop</a>
      <a href="/blog/">Blog</a>
      <a href="/#newsletter">Newsletter</a>
    </nav>

    <nav class="foot__col" aria-label="Company">
      <span class="foot__h">Company</span>
      <a href="/#story">About Blu</a>
      <a href="/studio/">Work with us</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>

  <div class="wrap foot__base">
    <span>© {year} Blu Baby Show</span>
    <span class="foot__legal">
      <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/refund/">Refunds</a> · <a href="/delivery/">Delivery</a> · <a href="/contact/">Contact</a>
    </span>
  </div>
</footer>

<style>
  .foot {
    background: #223a5c;
    color: #d6ecff;
    padding: 3.5rem 0 2rem;
    margin-top: 2rem;
  }
  .foot__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
  }
  .foot__word {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .foot__mark { width: 36px; height: 36px; border-radius: 50%; display: block; }
  .foot__tag {
    font-family: var(--font-serif);
    font-style: italic;
    color: rgba(214, 236, 255, 0.78);
    max-width: 30ch;
    margin: 0.8rem 0 1.2rem;
  }
  .foot__social { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; font-weight: 500; }
  .foot__social a { color: #d6ecff; }
  .foot__social a:hover { color: #fff; }

  .foot__col { display: flex; flex-direction: column; gap: 0.6rem; }
  .foot__h {
    font-family: var(--font-head);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    color: rgba(214, 236, 255, 0.6);
    margin-bottom: 0.3rem;
  }
  .foot__col a { color: #bcd8f2; padding: 0.35rem 0; }
  .foot__col a:hover { color: #fff; }

  .foot__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.12);
    font-size: 0.85rem;
    color: rgba(214, 236, 255, 0.6);
  }
  .foot__legal a { color: rgba(214, 236, 255, 0.6); }
  .foot__legal a:hover { color: #d6ecff; }

  @media (max-width: 760px) {
    .foot__inner { grid-template-columns: 1fr 1fr; }
    .foot__brand { grid-column: 1 / -1; }
    .foot__base { flex-direction: column; gap: 0.6rem; text-align: center; }
  }
</style>
