---
// Blululu header: red announcement bar + white header (menu · wordmark · icons).
// One navigation for the whole site: Shop · BluBabyShow · Blog · About.
// The phone menu is a no-JS checkbox toggle.
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const links = [
  { href: '/shop/', label: 'Shop' },
  { href: '/blubabyshow/', label: 'BluBabyShow' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];
const on = (href: string) => path === href || path.startsWith(href);
const notes = ['Blululu Originals now live', 'Free printables every week', 'New kits: join the waitlist'];
---

<div class="ann" role="note">
  <div class="ann__row">
    {notes.map((n, i) => (<>{i > 0 && <span class="ann__dot" aria-hidden="true">•</span>}<span class={i > 0 ? 'ann__extra' : ''}>{n}</span></>))}
  </div>
</div>

<header class="hdr">
  <input type="checkbox" id="navtoggle" class="hdr__toggle" aria-hidden="true" tabindex="-1" />
  <div class="hdr__bar">
    <div class="hdr__left">
      <label for="navtoggle" class="hdr__icon hdr__burger" aria-label="Open menu">
        <Icon name="menu" size={22} />
      </label>
      <nav class="hdr__links" aria-label="Main">
        {links.map((l) => <a href={l.href} aria-current={on(l.href) ? 'page' : undefined}>{l.label}</a>)}
      </nav>
    </div>
    <a class="hdr__logo" href="/" aria-label="Blululu home">
      <img src="/brand/blululu-red.svg" alt="Blululu" width="120" height="50" />
    </a>
    <div class="hdr__right">
      <a class="hdr__icon" href="/#newsletter" aria-label="Free printables by email"><Icon name="mail" size={20} /></a>
      <a class="hdr__icon" href="/shop/" aria-label="Shop"><Icon name="bag" size={20} /></a>
    </div>
  </div>

  <div class="drawer">
    <label for="navtoggle" class="drawer__scrim" aria-label="Close menu"></label>
    <div class="drawer__panel">
      <div class="drawer__top">
        <img src="/brand/blululu-red.svg" alt="Blululu" width="110" height="46" />
        <label for="navtoggle" class="hdr__icon" aria-label="Close menu"><Icon name="close" size={22} /></label>
      </div>
      <nav class="drawer__links" aria-label="Menu">
        {links.map((l) => <a href={l.href} aria-current={on(l.href) ? 'page' : undefined}>{l.label}<Icon name="arrow" size={18} /></a>)}
      </nav>
      <div class="drawer__more">
        <a href="/kits/">Kits (coming soon)</a>
        <a href="/#newsletter">Free printables</a>
        <a href="/contact/">Contact</a>
      </div>
    </div>
  </div>
</header>

<style>
  .ann { background: var(--red); color: #fff; }
  .ann__row {
    max-width: var(--maxw); margin: 0 auto; padding: 0.55rem 16px;
    display: flex; justify-content: center; align-items: center; gap: 1.1rem;
    font-family: var(--font-head); font-weight: 800; font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.06em; text-align: center;
  }
  .ann__dot { opacity: 0.8; }
  @media (max-width: 760px) { .ann__extra, .ann__dot { display: none; } }

  .hdr { position: sticky; top: 0; z-index: 100; background: #fff; border-bottom: 1px solid var(--line); }
  .hdr__toggle { position: absolute; opacity: 0; pointer-events: none; }
  .hdr__bar {
    max-width: var(--maxw); margin: 0 auto; height: var(--hdr-h); padding: 0 12px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px;
  }
  .hdr__left { display: flex; align-items: center; gap: 1.4rem; }
  .hdr__right { display: flex; justify-content: flex-end; gap: 8px; }
  .hdr__logo img { height: 40px; width: auto; }
  .hdr__icon {
    width: 44px; height: 44px; border-radius: 12px; background: var(--light); color: var(--ink);
    display: inline-grid; place-items: center; cursor: pointer; transition: background .15s;
  }
  .hdr__icon:hover { background: var(--red-soft); }
  .hdr__links { display: none; gap: 1.5rem; }
  .hdr__links a { font-family: var(--font-head); font-weight: 700; font-size: 0.95rem; color: var(--ink); padding: 0.4rem 0; border-bottom: 2px solid transparent; }
  .hdr__links a:hover, .hdr__links a[aria-current] { border-color: var(--red); }
  @media (min-width: 900px) {
    .hdr__bar { padding: 0 24px; }
    .hdr__burger { display: none; }
    .hdr__links { display: flex; }
    .hdr__logo img { height: 44px; }
  }

  .drawer { position: fixed; inset: 0; z-index: 200; visibility: hidden; }
  .drawer__scrim { position: absolute; inset: 0; background: rgba(22,18,15,.45); opacity: 0; transition: opacity .2s; cursor: pointer; }
  .drawer__panel {
    position: absolute; top: 0; left: 0; bottom: 0; width: min(86vw, 360px); background: #fff;
    padding: 12px 20px 28px; transform: translateX(-100%); transition: transform .25s ease; overflow-y: auto;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .drawer__top { display: flex; justify-content: space-between; align-items: center; height: 52px; }
  .drawer__top img { height: 36px; width: auto; }
  .drawer__links { display: flex; flex-direction: column; }
  .drawer__links a {
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-head); font-weight: 900; font-size: 1.6rem; text-transform: uppercase;
    padding: 0.9rem 0; border-bottom: 1px solid var(--line);
  }
  .drawer__links a[aria-current] { color: var(--red-text); }
  .drawer__more { display: flex; flex-direction: column; gap: 0.2rem; }
  .drawer__more a { padding: 0.6rem 0; font-weight: 700; color: var(--ink-soft); }
  .hdr__toggle:checked ~ .drawer { visibility: visible; }
  .hdr__toggle:checked ~ .drawer .drawer__scrim { opacity: 1; }
  .hdr__toggle:checked ~ .drawer .drawer__panel { transform: none; }
  @media (min-width: 900px) { .drawer { display: none; } }
</style>
