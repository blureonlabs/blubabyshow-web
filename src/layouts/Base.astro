---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a 1200x630 share image. */
  image?: string;
  imageAlt?: string;
  /** og:type — 'website' (default), 'product', 'article'. */
  type?: string;
  /** Hide this page from search (e.g. /thanks). */
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page (merged into the @graph). */
  jsonLd?: Record<string, unknown>[];
}

const SITE = 'https://www.blubabyshow.com';
const DEFAULT_TITLE = 'Blu Baby Show · 3D animated stories about big feelings for toddlers';
const DEFAULT_DESC =
  'Blu Baby Show is a 3D animated show about Blu, a 2-year-old boy, and his family. Short, gentle episodes that teach toddlers feelings before facts. Watched 92M+ times on Instagram.';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESC,
  image = '/og/default.png',
  imageAlt = 'Blu Baby Show: Blu with Mum, Dad, baby Sister and Puppy',
  type = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

// Canonical: always www + trailing slash (Astro builds every page as /path/index.html).
let path = Astro.url.pathname;
if (!path.endsWith('/') && !path.split('/').pop()!.includes('.')) path += '/';
const canonical = new URL(path, SITE).href;
const ogImage = new URL(image, SITE).href;
const isHome = path === '/';

const ORG_ID = `${SITE}/#org`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: 'Blu Baby Show',
    url: `${SITE}/`,
    logo: { '@type': 'ImageObject', url: `${SITE}/brand/logo-512.jpg` },
    image: `${SITE}/og/default.png`,
    description:
      'Blu Baby Show makes short 3D animated stories about Blu, a 2-year-old boy, and his family, plus printable PDFs for parents of young children.',
    email: 'blubabyshow@gmail.com',
    sameAs: ['https://www.instagram.com/theblubabyshow/', 'https://www.youtube.com/@blubabyshow'],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'blubabyshow@gmail.com',
      availableLanguage: ['English'],
    },
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE}/#website`,
    url: `${SITE}/`,
    name: 'Blu Baby Show',
    publisher: { '@id': ORG_ID },
    inLanguage: 'en',
  },
];

if (isHome) {
  graph.push({
    '@type': 'CreativeWorkSeries',
    '@id': `${SITE}/#show`,
    name: 'Blu Baby Show',
    url: `${SITE}/`,
    description:
      'A 3D animated short-form series about Blu, a 2-year-old boy, and his everyday big feelings with Mum, Dad, baby Sister and Puppy. Episodes run 15 to 30 seconds and are published on Instagram and YouTube.',
    genre: ['Animation', 'Family', 'Children'],
    inLanguage: 'en',
    image: `${SITE}/og/default.png`,
    audience: { '@type': 'PeopleAudience', audienceType: 'Parents of toddlers and young children', suggestedMinAge: 1 },
    character: [
      { '@type': 'Person', name: 'Blu', description: 'A curious 2-year-old boy, the main character.' },
      { '@type': 'Person', name: 'Mum', description: "Blu's mother." },
      { '@type': 'Person', name: 'Dad', description: "Blu's father." },
      { '@type': 'Person', name: 'Sister', description: "Blu's baby sister." },
      { '@type': 'Person', name: 'Puppy', description: "The family's Dalmatian puppy." },
    ],
    productionCompany: { '@id': ORG_ID },
    publisher: { '@id': ORG_ID },
    sameAs: ['https://www.instagram.com/theblubabyshow/', 'https://www.youtube.com/@blubabyshow'],
  });
}

graph.push(...jsonLd);
const ld = { '@context': 'https://schema.org', '@graph': graph };

// Analytics (PostHog): visitor counts, autocaptured clicks, funnels/drop-off.
// Set PUBLIC_POSTHOG_KEY in Vercel env to enable (no key = analytics off).
const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY;
const POSTHOG_HOST = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://us.i.posthog.com';

// Google Search Console: paste the token from the "HTML tag" verification method.
// Set PUBLIC_GSC_VERIFICATION in Vercel env (no value = tag omitted).
const GSC_VERIFICATION = import.meta.env.PUBLIC_GSC_VERIFICATION;

// Meta Pixel (browser side). Set PUBLIC_META_PIXEL_ID in Vercel env; no ID = no pixel.
// Purchase is sent server-side (Conversions API) from the Dodo webhook, not from the browser.
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID ?? '1119556160690188';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#57b0f0" />
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    <meta name="facebook-domain-verification" content="o9f82bhu2h91g8vgahngsjqsc0z405" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blu Baby Show blog" href="/rss.xml" />

    <!-- Open Graph / social -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Blu Baby Show" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Fonts: Fredoka (headings) · Nunito (body) · Newsreader (serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;500;600;700;800&family=Newsreader:ital,opsz@0,6..72;1,6..72&display=swap"
      rel="stylesheet"
    />

    <!-- Privacy: strip buyer PII (Dodo appends it to the /thanks return URL) before analytics loads -->
    <script is:inline>
      (function(){try{var u=new URL(location.href),d=false;['email','customer_email','name','phone'].forEach(function(k){if(u.searchParams.has(k)){u.searchParams.delete(k);d=true}});if(d)history.replaceState(history.state,'',u.pathname+u.search+u.hash)}catch(e){}})();
    </script>

    <!-- Analytics: PostHog (pageviews + autocaptured clicks + bounce for funnels/drop-off) -->
    {POSTHOG_KEY && (
      <script is:inline define:vars={{ POSTHOG_KEY, POSTHOG_HOST }}>
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init(POSTHOG_KEY,{api_host:POSTHOG_HOST,person_profiles:'identified_only',capture_pageview:true,capture_pageleave:true,autocapture:true});
      </script>
    )}

    {META_PIXEL_ID && (
      <script is:inline define:vars={{ META_PIXEL_ID }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', META_PIXEL_ID);
        fbq('track', 'PageView');
      </script>
    )}

    <!-- Structured data: brand + site (+ show on home, + page-specific nodes) -->
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
