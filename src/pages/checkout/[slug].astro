---
// Custom checkout page: our order summary + the Dodo Payments inline checkout frame.
// Flow: page asks /api/checkout for a session -> embeds it with dodopayments-checkout (inline).
// Anything fails (no API key, API error, SDK chunk fails, frame never opens) -> the buyer is sent
// to the static Dodo /buy/ link, so a sale is never lost. Buy buttons only point here when
// CUSTOM_CHECKOUT is true in src/data/products.ts. How it works: docs/CUSTOM_CHECKOUT.md.
import Base from '../../layouts/Base.astro';
import { products, bySlug } from '../../data/products';

export function getStaticPaths() {
  // 'test-20': hidden ₹20 live test product (founder's own test payment). Not linked anywhere.
  return [...products.map((p) => ({ params: { slug: p.slug } })), { params: { slug: 'test-20' } }];
}

const isTest = Astro.params.slug === 'test-20';
const base = bySlug(isTest ? 'colouring-pack' : Astro.params.slug!)!;
const p = isTest
  ? { ...base, slug: 'test-20', name: 'TEST payment ₹50 (Colouring Pack PDF)', inr: 50, usd: 0.6, checkoutInr: 'https://checkout.dodopayments.com/buy/pdt_0NsBp2SYkI75fBvYddfr1?quantity=1', checkoutUsd: undefined }
  : base;
// Fallback = the same static Dodo link the buy buttons use today (product page if the shop is off).
const staticHref = p.checkoutInr || p.checkoutUsd || `/shop/${p.slug}/`;
const pages = p.format.match(/(\d+) pages/)?.[1];
---

<Base
  title={`Checkout · ${p.name.replace(' (PDF)', '')} · The Blu Shop`}
  description={`Secure checkout for ${p.name}. Instant PDF download.`}
  noindex
>
  <section class="co" style={`--c:${p.accent}`} data-slug={p.slug} data-inr={p.inr} data-usd={p.usd} data-static={staticHref}>
    <div class="wrap co__grid">
      <aside class="sum" aria-labelledby="sumH">
        <p class="eyebrow">Checkout</p>
        <div class="sum__item">
          <div class="sum__art"><img src={p.img} alt={p.imgAlt} width="120" height="120" /></div>
          <div>
            <h1 id="sumH" class="sum__name">{p.name}</h1>
            <p class="sum__fmt">PDF soft copy{pages ? ` · ${pages} pages` : ''} · nothing is shipped</p>
          </div>
        </div>

        <details class="sum__inside">
          <summary>What's inside</summary>
          <ul>{p.inside.map((i) => <li>{i}</li>)}</ul>
        </details>

        <dl class="sum__rows" aria-live="polite">
          <div class="row" data-row="sub"><dt>Price</dt><dd data-out="sub"><span data-price-inr={p.inr} data-price-usd={p.usd}>₹{p.inr}</span></dd></div>
          <div class="row" data-row="discount" hidden><dt>Discount</dt><dd data-out="discount"></dd></div>
          <div class="row" data-row="tax"><dt>Tax</dt><dd data-out="tax" class="soft">worked out at checkout</dd></div>
          <div class="row row--total"><dt>Total</dt><dd data-out="total"><span data-price-inr={p.inr} data-price-usd={p.usd}>₹{p.inr}</span></dd></div>
        </dl>
        <p class="sum__note soft" data-out="note">Your price is set by your country. Tax is added at checkout where it applies.</p>

        <p class="pill">⚡ Instant PDF download: the link comes by email right after you pay.</p>

        <ul class="trust">
          <li>🔒 Secure payment by Dodo Payments, Merchant of Record; tax handled at checkout.</li>
          <li>⚡ Digital download: by paying you ask for instant access, so the order is final once the file is delivered. <a href="/terms/">Terms</a></li>
          <li>📄 Download problems? Email us and we will send the file again.</li>
        </ul>
      </aside>

      <div class="pay">
        <div class="pay__box">
          <div class="pay__wait" data-wait>
            <span class="spin" aria-hidden="true"></span>
            <p>Loading secure checkout…</p>
          </div>
          <div id="dodo-inline-checkout"></div>
        </div>
        <p class="pay__alt soft" data-offer="checkout_page_link" data-slug={p.slug}>
          Trouble with the form? <a href={staticHref} data-alt data-slug={p.slug}>Pay on the Dodo checkout page instead</a>.
        </p>
        <noscript><p class="pay__alt"><a href={staticHref}>Continue to secure checkout</a></p></noscript>
        <!-- Phone only: the notes move under the form so the form starts on the first screen. -->
        <ul class="trust trust--m">
          <li>⚡ Instant PDF download: the link comes by email right after you pay.</li>
          <li>🔒 Secure payment by Dodo Payments; tax handled at checkout.</li>
          <li>Digital download: the order is final once the file is delivered. <a href="/terms/">Terms</a></li>
          <li>📄 Download problems? Email us and we will send the file again.</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<!-- Safety net: if the module script below never runs (blocked, failed to load), send the buyer to
     the static Dodo link after 20 s so a sale is never lost. The module script clears it. -->
<script is:inline define:vars={{ staticHref }}>
  window.__bbsCoTimer = setTimeout(function () { try { location.replace(staticHref); } catch (e) {} }, 20000);
</script>

<script>
  import { track, inIndia, currency } from '../../lib/track';
  const w = window as any;
  const root = document.querySelector<HTMLElement>('.co')!;
  const slug = root.dataset.slug!;
  const staticHref = root.dataset.static!;
  const wait = root.querySelector<HTMLElement>('[data-wait]')!;
  const started = performance.now();
  clearTimeout(w.__bbsCoTimer);

  // Local price before the frame reports the real breakdown (same rule as the buy buttons).
  root.querySelectorAll<HTMLElement>('[data-price-inr]').forEach((el) => {
    el.textContent = inIndia ? `₹${el.dataset.priceInr}` : `$${el.dataset.priceUsd}`;
  });
  track('checkout_page_viewed', { product: slug, price_shown: Number(inIndia ? root.dataset.inr : root.dataset.usd), currency });

  // PostHog ids (random ids, never email/card). Wait briefly for PostHog to load; no key = skip.
  const phIds = async () => {
    if (!w.posthog) return {};
    for (let i = 0; i < 15 && !w.posthog.__loaded; i++) await new Promise((r) => setTimeout(r, 100));
    try {
      const id = w.posthog.get_distinct_id?.();
      const sid = w.posthog.get_session_id?.();
      return { ph_id: typeof id === 'string' ? id : undefined, ph_session: typeof sid === 'string' ? sid : undefined };
    } catch { return {}; }
  };

  let done = false;
  const fallback = async (reason: string) => {
    if (done) return;
    done = true;
    let href = staticHref;
    try {
      const ids = await phIds();
      const u = new URL(staticHref, location.href);
      if (/(^|\.)dodopayments\.com$/.test(u.hostname)) {
        if (ids.ph_id) u.searchParams.set('metadata_ph_id', ids.ph_id);
        if (ids.ph_session) u.searchParams.set('metadata_ph_session', ids.ph_session);
      }
      href = u.href;
    } catch {}
    track('checkout_failed_fallback', { product: slug, reason, currency }, true);
    location.replace(href);
  };

  // Breakdown from the frame: amounts are in the smallest unit (paise/cents).
  const ZERO_DEC = new Set(['JPY', 'KRW', 'VND', 'CLP', 'ISK', 'UGX', 'XAF', 'XOF', 'PYG', 'RWF']);
  const fmt = (amt: unknown, cur: unknown) => {
    if (typeof amt !== 'number' || typeof cur !== 'string' || !cur) return null;
    const c = cur.toUpperCase();
    try { return new Intl.NumberFormat(undefined, { style: 'currency', currency: c }).format(ZERO_DEC.has(c) ? amt : amt / 100); }
    catch { return `${c} ${(ZERO_DEC.has(c) ? amt : amt / 100).toFixed(ZERO_DEC.has(c) ? 0 : 2)}`; }
  };
  const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
  const showBreakdown = (b: Record<string, unknown>) => {
    const cur = (b.currency as string) || (b.finalTotalCurrency as string);
    const sub = fmt(b.subTotal, cur);
    if (sub) out('sub').textContent = sub;
    const disc = typeof b.discount === 'number' && b.discount > 0 ? fmt(b.discount, cur) : null;
    const dRow = root.querySelector<HTMLElement>('[data-row="discount"]')!;
    dRow.hidden = !disc;
    if (disc) out('discount').textContent = `−${disc}`;
    const tax = fmt(b.tax, cur);
    const taxEl = out('tax');
    if (tax && (b.tax as number) > 0) { taxEl.textContent = tax; taxEl.classList.remove('soft'); }
    else { taxEl.textContent = 'worked out at checkout'; taxEl.classList.add('soft'); }
    const total = fmt(b.finalTotal ?? b.total, (b.finalTotalCurrency as string) || cur);
    if (total) out('total').textContent = total;
    out('note').textContent = 'Live from the secure checkout. It updates when you pick your country.';
  };

  const run = async () => {
    // 1) Session from our server (slug only; the server picks the product).
    let data: any = null;
    try {
      const ids = await phIds();
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), 10000);
      const r = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ p: slug, ...ids }),
        signal: ctrl.signal,
      });
      clearTimeout(t);
      data = await r.json().catch(() => null);
    } catch { return fallback('api_unreachable'); }
    if (!data || typeof data.checkout_url !== 'string' || data.fallback) return fallback('api_fallback');

    // 2) The SDK (its own chunk: a failed download is caught here).
    let sdk: any;
    try { sdk = (await import('dodopayments-checkout')).DodoPayments; }
    catch { return fallback('sdk_load'); }

    let opened = false;
    // No frame at all after 15 s -> hosted page. Frame there but slow -> keep waiting (never yank a
    // buyer away mid-form); the "Pay on the Dodo checkout page instead" link stays visible.
    const openTimer = setTimeout(() => {
      if (opened) return;
      if (document.querySelector('#dodo-inline-checkout iframe')) {
        const msg = wait.querySelector('p');
        if (msg) msg.textContent = 'Still loading… You can also use the Dodo checkout link below.';
        track('checkout_slow', { product: slug });
      } else fallback('frame_timeout');
    }, 15000);
    const ready = () => {
      if (opened) return;
      opened = true;
      clearTimeout(openTimer);
      wait.hidden = true;
      track('checkout_loaded', { product: slug, mode: data.mode, ms: Math.round(performance.now() - started) });
    };

    try {
      sdk.Initialize({
        mode: data.mode === 'live' ? 'live' : 'test',
        displayType: 'inline',
        onEvent: (e: { event_type: string; data?: Record<string, any> }) => {
          switch (e.event_type) {
            case 'checkout.opened':
            case 'checkout.form_ready':
              ready();
              break;
            case 'checkout.breakdown':
              if (e.data?.message && typeof e.data.message === 'object') showBreakdown(e.data.message);
              break;
            case 'checkout.pay_button_clicked':
              track('checkout_pay_clicked', { product: slug });
              break;
            case 'checkout.error':
              // Before the form shows: send them to the hosted page. After: leave them be (the
              // frame shows its own message) and keep the "pay on the Dodo page" link visible.
              if (!opened) fallback('frame_error');
              break;
            case 'checkout.link_expired':
              location.reload();
              break;
          }
        },
      });
      sdk.Checkout.open({ checkoutUrl: data.checkout_url, elementId: 'dodo-inline-checkout' });
      // Backup ready signal: the frame's own load event (some browsers/extensions drop SDK messages).
      const hook = setInterval(() => {
        const f = document.querySelector<HTMLIFrameElement>('#dodo-inline-checkout iframe');
        if (!f) return;
        clearInterval(hook);
        f.addEventListener('load', () => setTimeout(ready, 1500), { once: true });
      }, 100);
      setTimeout(() => clearInterval(hook), 20000);
    } catch { clearTimeout(openTimer); return fallback('sdk_error'); }
  };
  run();
</script>

<style>
  .co { padding: calc(var(--nav-h) + 1.5rem) 0 3rem; background: var(--base); }
  .co__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 2rem; align-items: start; }
  .sum { background: var(--paper); border-radius: var(--radius); padding: 1.6rem; box-shadow: var(--shadow-soft); position: sticky; top: calc(var(--nav-h) + 1rem); }
  .sum .eyebrow { margin-bottom: 0.8rem; }
  .sum__item { display: flex; gap: 1rem; align-items: center; }
  .sum__art { flex: 0 0 auto; width: 96px; height: 96px; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--c) 18%, var(--paper)); display: grid; place-items: center; overflow: hidden; }
  .sum__art img { width: 86%; height: auto; }
  .sum__name { font-size: 1.25rem; line-height: 1.25; margin: 0 0 0.25rem; color: var(--blu-deep); }
  .sum__fmt { margin: 0; font-size: 0.92rem; color: var(--ink-soft); }
  .sum__inside { margin: 1rem 0 0; border-top: 1px dashed var(--sand-2); padding-top: 0.8rem; }
  .sum__inside summary { cursor: pointer; font-weight: 700; color: var(--blu-deep); }
  .sum__inside ul { margin: 0.6rem 0 0; padding-left: 1.2rem; font-size: 0.95rem; }
  .sum__inside li { margin: 0.3rem 0; }
  .sum__rows { margin: 1rem 0 0; border-top: 1px dashed var(--sand-2); padding-top: 0.6rem; }
  .row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.35rem 0; }
  .row[hidden] { display: none; }
  .row dt { margin: 0; }
  .row dd { margin: 0; font-weight: 700; text-align: right; }
  .row--total { border-top: 2px solid var(--sand-2); margin-top: 0.3rem; padding-top: 0.6rem; font-family: var(--font-head); font-size: 1.35rem; color: var(--blu-deep); }
  .soft { color: var(--ink-soft); font-weight: 500 !important; font-size: 0.9rem; }
  .sum__note { margin: 0.3rem 0 0; }
  .pill { background: var(--sand); border-radius: var(--radius-sm); padding: 0.6rem 0.9rem; font-weight: 700; font-size: 0.95rem; margin: 1rem 0 0; }
  .trust { list-style: none; padding: 0; margin: 1rem 0 0; font-size: 0.9rem; color: var(--ink-soft); }
  .trust li { margin: 0.45rem 0; }
  .trust a { color: var(--blu-d); }
  .pay__box { position: relative; background: var(--paper); border-radius: var(--radius); box-shadow: var(--shadow-soft); padding: 0.5rem; min-height: 560px; overflow: hidden; }
  #dodo-inline-checkout { width: 100%; }
  .pay__wait { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 0.6rem; color: var(--ink-soft); }
  .pay__wait[hidden] { display: none; }
  .spin { width: 34px; height: 34px; border-radius: 50%; border: 4px solid var(--cream-2); border-top-color: var(--blu); animation: spin 0.9s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .pay__alt { text-align: center; font-size: 0.88rem; margin: 0.8rem 0 0; }
  .pay__alt a { color: var(--blu-d); }
  .trust--m { display: none; }
  @media (max-width: 860px) {
    .co { padding-top: calc(var(--nav-h) + 0.8rem); }
    .sum .eyebrow, .sum__inside, .sum__note, .sum .pill, .sum .trust, .row[data-row="sub"], .row[data-row="tax"] { display: none; }
    .sum__rows { margin-top: 0.6rem; padding-top: 0.3rem; }
    .row--total { border-top: 0; margin: 0; padding-top: 0.2rem; font-size: 1.15rem; }
    .trust--m { display: block; padding: 0 0.3rem; }
    .pay__box { min-height: 480px; }
    .co__grid { grid-template-columns: 1fr; gap: 1rem; }
    .wrap.co__grid { padding: 0 16px; }
    .sum { position: static; padding: 1.1rem; border-radius: var(--radius-sm); }
    .sum__art { width: 56px; height: 56px; }
    .sum__name { font-size: 1.08rem; }
    .pay__box { border-radius: var(--radius-sm); padding: 0.25rem; }
  }
  @media (prefers-reduced-motion: reduce) { .spin { animation: none; } }
</style>
