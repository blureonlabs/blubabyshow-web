---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, CLUSTER_LABELS, SITE } from '../../lib/posts';
import { CLUSTERS } from '../../content/config';

const posts = await getPublishedPosts();
const groups = CLUSTERS.map((c) => ({ id: c, label: CLUSTER_LABELS[c], posts: posts.filter((p) => p.data.cluster === c) })).filter(
  (g) => g.posts.length > 0
);

const title = 'Small Moments: the Blu Baby Show blog';
const description = 'Gentle, practical notes for parents of little ones: big feelings, new siblings, screen-free play, early learning and parent life.';
const jsonLd = [
  {
    '@type': 'Blog',
    '@id': `${SITE}/blog/#blog`,
    name: title,
    description,
    url: `${SITE}/blog/`,
    publisher: { '@id': `${SITE}/#org` },
    inLanguage: 'en',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog/` },
    ],
  },
];
---

<Base title={`${title} · Blu Baby Show`} description={description} jsonLd={jsonLd}>
  <section class="section bloghero section--center">
    <div class="wrap">
      <p class="eyebrow">The Blu Baby Show blog</p>
      <h1>Small Moments</h1>
      <p class="bloghero__sub muted">Gentle, practical notes for parents of little ones.</p>
      {groups.length > 1 && (
        <nav class="chips" aria-label="Topics">
          <a class="chip" href="#all">All</a>
          {groups.map((g) => <a class="chip" href={`#${g.id}`}>{g.label}</a>)}
        </nav>
      )}
    </div>
  </section>

  <section class="section bloglist" id="all">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="center muted">New posts are on the way. Join Blu’s Sunday Club to hear first.</p>
      ) : (
        <>
          <h2 class="bloglist__h">Latest</h2>
          <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div>
          {groups.length > 1 &&
            groups.map((g) => (
              <section class="topic" id={g.id}>
                <h2 class="bloglist__h">{g.label}</h2>
                <div class="grid">{g.posts.map((p) => <PostCard post={p} />)}</div>
              </section>
            ))}
        </>
      )}
      <p class="rss muted center"><a href="/rss.xml">RSS feed</a></p>
    </div>
  </section>
</Base>

<style>
  .bloghero { padding-top: calc(var(--nav-h) + 2.5rem); padding-bottom: 1.5rem; }
  .bloghero__sub { font-size: 1.2rem; max-width: 46ch; margin: 0 auto 1.6rem; }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }
  .chip { font-family: var(--font-head); font-weight: 600; font-size: 0.95rem; color: var(--blu-deep); background: var(--paper); padding: 0.5rem 1.1rem; border-radius: 999px; box-shadow: var(--shadow-sticker); transition: background 0.15s ease; }
  .chip:hover { background: var(--cream-2); }
  .bloglist { padding-top: 1.5rem; }
  .bloglist__h { font-size: clamp(1.6rem, 3vw, 2.1rem); margin: 0 0 1.2rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1.5rem; }
  .topic { margin-top: 3.5rem; }
  .rss { margin-top: 3rem; font-size: 0.9rem; }
  .rss a { text-decoration: underline; }
</style>
