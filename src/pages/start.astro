---
// Link-in-bio page for @theblubabyshow. One job: turn an Instagram tap into an email or a sale.
import Base from '../layouts/Base.astro';
import { bySlug } from '../data/products';
const guide = bySlug('meltdown-scripts')!;
---

<Base title="Start here · Blu Baby Show" description="Free Blu Feelings Cards, calm scripts for toddler meltdowns, and personalised Blu videos." noindex>
  <section class="start">
    <div class="start__wrap">
      <img class="start__blu" src="/characters/blu.webp" alt="Blu" width="112" height="112" />
      <h1>Hi, it's Blu 💙</h1>
      <p class="start__sub">Little stories about big feelings. Here's how we can help at home.</p>

      <div class="tile tile--hero">
        <img src="/shop/cards-preview.webp" alt="Blu's Feelings Cards" width="960" height="504" loading="eager" />
        <p class="tile__tag">Free</p>
        <h2>Blu's Feelings Cards</h2>
        <p>10 printable cards to help your little one name big feelings, with gentle words for you on the back.</p>
        <form id="startForm" class="tile__form" novalidate>
          <input type="email" name="email" placeholder="your@email.com" aria-label="Email address" required />
          <input type="text" name="hp" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit">Send me the cards</button>
        </form>
        <p id="startMsg" class="tile__msg" role="status" aria-live="polite"></p>
        <p class="tile__fine">Plus one warm email on Sundays. Unsubscribe anytime.</p>
      </div>

      <a class="tile tile--link" href="/kits/potty/?utm_source=instagram&utm_medium=bio" data-track="kit-potty">
        <img src="/characters/blu.webp" alt="" width="88" height="88" />
        <span><strong>Blu Goes Potty kit</strong><br /><small>Potty training, step by step · video + story + what to say</small></span>
      </a>

      <a class="tile tile--link" href="/kits/" data-track="kits">
        <img src="/episodes/meets-baby-sister.webp" alt="" width="88" height="88" />
        <span><strong>All Blu Kits</strong><br /><small>New baby · kind hands · bedtime</small></span>
      </a>

      <a class="tile tile--link" href={`/shop/${guide.slug}/`} data-track="guide">
        <img src={guide.img} alt="" width="88" height="88" />
        <span><strong>{guide.name}</strong><br /><small>20 calm scripts · <span data-price-inr={guide.inr} data-price-usd={guide.usd}>₹{guide.inr}</span> · instant PDF</small></span>
      </a>

      <a class="tile tile--link" href="https://ig.me/m/theblubabyshow" data-track="video">
        <img src="/episodes/picks-his-outfit.webp" alt="" width="88" height="88" />
        <span><strong>A Blu video with your child's name</strong><br /><small>15 seconds · no photos needed · message us</small></span>
      </a>

      <a class="tile tile--link" href="/blog/" data-track="blog">
        <img src="/episodes/kisses-sister.webp" alt="" width="88" height="88" />
        <span><strong>Small Moments blog</strong><br /><small>Tantrums, new siblings, play: sourced, gentle tips</small></span>
      </a>

      <a class="tile tile--link" href="/#watch" data-track="watch">
        <img src="/episodes/belly-hug.webp" alt="" width="88" height="88" />
        <span><strong>Watch Blu</strong><br /><small>Our most-loved episodes</small></span>
      </a>

      <p class="start__foot"><a href="/">blubabyshow.com</a> · <a href="/contact">Contact</a></p>
    </div>
  </section>
</Base>

<script>
  const w = window as any;
  // Prices by visitor region (same rule as the shop).
  const inIndia = (() => { try { return /Asia\/(Kolkata|Calcutta)/.test(Intl.DateTimeFormat().resolvedOptions().timeZone); } catch { return true; } })();
  document.querySelectorAll<HTMLElement>('[data-price-inr]').forEach((el) => {
    el.textContent = inIndia ? `₹${el.dataset.priceInr}` : `$${el.dataset.priceUsd}`;
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-track]').forEach((a) =>
    a.addEventListener('click', () => w.posthog?.capture?.('start_click', { target: a.dataset.track })));

  const form = document.getElementById('startForm') as HTMLFormElement | null;
  const msg = document.getElementById('startMsg');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.querySelector('input[type=email]') as HTMLInputElement).value.trim();
    const hp = (form.querySelector('input[name=hp]') as HTMLInputElement).value;
    const btn = form.querySelector('button') as HTMLButtonElement;
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg!.textContent = 'Please enter a valid email 💛'; return; }
    btn.disabled = true; btn.textContent = 'Sending…';
    try {
      const res = await fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, source: 'link-in-bio', hp }) });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        form.style.display = 'none';
        msg!.innerHTML = "You're in! 💛 <a href='/free/blu-feelings-cards-A4.pdf' download>Download your cards (PDF)</a>. We've emailed them too.";
        w.posthog?.capture?.('newsletter_signup', { source: 'link-in-bio' });
        w.fbq?.('track', 'Lead', { content_name: 'feelings-cards' });
      } else {
        msg!.textContent = data.error || 'Something went wrong, please try again.';
        btn.disabled = false; btn.textContent = 'Send me the cards';
      }
    } catch {
      msg!.textContent = 'Network hiccup, please try again.';
      btn.disabled = false; btn.textContent = 'Send me the cards';
    }
  });
</script>

<style>
  .start { padding: calc(var(--nav-h) + 1.5rem) 16px 3rem; background: #FBF3E7; }
  .start__wrap { max-width: 480px; margin: 0 auto; text-align: center; }
  .start__blu { width: 112px; height: 112px; border-radius: 50%; object-fit: contain; background: #dceeff; border: 4px solid #fff; box-shadow: 0 6px 18px rgba(34,58,92,.15); }
  .start h1 { margin: 0.6rem 0 0.2rem; font-size: 1.7rem; }
  .start__sub { color: #5c5d7a; margin: 0 0 1.4rem; }
  .tile { display: block; background: #fff; border-radius: 20px; padding: 1rem; margin-bottom: 0.9rem; box-shadow: 0 4px 16px rgba(34,58,92,.08); text-align: left; color: inherit; text-decoration: none; }
  .tile--hero { text-align: center; padding: 1.1rem; border: 3px solid var(--sun, #ffc93c); }
  .tile--hero img { width: 100%; height: auto; border-radius: 14px; }
  .tile__tag { display: inline-block; background: var(--sun, #ffc93c); color: #223a5c; font-weight: 700; font-size: 0.8rem; border-radius: 999px; padding: 0.15rem 0.7rem; margin: 0.8rem 0 0.2rem; }
  .tile h2 { font-size: 1.3rem; margin: 0.2rem 0; }
  .tile p { margin: 0.3rem 0; }
  .tile__form { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.8rem; }
  .tile__form input[type=email] { padding: 0.85rem 1rem; border-radius: 999px; border: 2px solid #d6e4f0; font-size: 1rem; }
  .tile__form button { padding: 0.9rem; border: 0; border-radius: 999px; background: #30598a; color: #fff; font-weight: 700; font-size: 1rem; cursor: pointer; }
  .tile__msg { font-weight: 600; color: #30598a; }
  .tile__msg a { text-decoration: underline; }
  .tile__fine { font-size: 0.8rem; color: #6b6c85; }
  .tile--link { display: flex; align-items: center; gap: 0.9rem; transition: transform .15s; }
  .tile--link:hover { transform: translateY(-2px); }
  .tile--link img { width: 64px; height: 64px; border-radius: 14px; object-fit: cover; flex: none; }
  .tile--link small { color: #5c5d7a; }
  .hp { position: absolute; left: -9999px; }
  .start__foot { font-size: 0.85rem; color: #6b6c85; margin-top: 1.4rem; }
  .start__foot a { color: inherit; }
</style>
