---
import Base from '../layouts/Base.astro';

// B2B landing page for the AI-content studio behind Blu Baby Show.
// Sent to brands/prospects (bio link + DM replies). Consumer homepage is untouched.
const stats = [
  { n: '92M+', l: 'views generated' },
  { n: '19M', l: 'top reel, organic' },
  { n: '100%', l: 'made with AI' },
  { n: '₹0', l: 'ad spend' },
];

const services = [
  { icon: '🎬', t: 'Character-driven video', d: 'Consistent, feature-film quality 3D characters — your mascot or ours — across every clip. No film crew, no reshoots.' },
  { icon: '🥺', t: 'Emotional short-form that travels', d: 'Reels & Shorts engineered to stop the scroll and earn the share. We reverse-engineer what actually goes viral.' },
  { icon: '⚙️', t: 'The whole pipeline', d: 'Concept → script → AI generation → edit → captions → posting strategy. You get content that\'s ready to publish.' },
  { icon: '📈', t: 'Organic growth strategy', d: 'We grew Blu to tens of millions of views with zero ad spend. We bring the same playbook to your brand.' },
];

const steps = [
  { n: '01', t: 'Brief', d: 'Tell us your brand, audience, and goal.' },
  { n: '02', t: 'Concept + script', d: 'We design the beat and write the shot.' },
  { n: '03', t: 'AI production', d: 'We generate, edit, and caption it.' },
  { n: '04', t: 'Delivery', d: 'Ready-to-post video, on-brand and on time.' },
];
---

<Base
  title="Blureon Labs · The AI content studio behind Blu Baby Show"
  description="The AI content studio behind Blu Baby Show (92M+ Instagram views, made entirely with AI). We make 3D animated, character-led short video for brands."
>
  <!-- HERO -->
  <section class="section shero section--center">
    <div class="wrap">
      <p class="eyebrow">AI-Native Content Studio</p>
      <h1>We turned a baby into <span class="hl">92 million views.</span><br />With AI. From zero.</h1>
      <p class="shero__sub muted">
        We're the studio behind <strong>Blu Baby Show</strong> — 3D animated, scroll-stopping video
        made entirely with AI. Now we make it for brands like yours.
      </p>
      <div class="shero__cta">
        <a class="btn btn--primary" href="#contact">Work with us</a>
        <a class="btn btn--ghost" href="https://instagram.com/theblubabyshow" target="_blank" rel="noopener">See the work ↗</a>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="proof">
    <div class="wrap proof__row">
      {stats.map((s) => (
        <div class="proof__stat">
          <strong>{s.n}</strong>
          <span>{s.l}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section" id="services">
    <div class="wrap">
      <div class="section__head section--center">
        <p class="eyebrow">What we make</p>
        <h2>Content that actually travels</h2>
        <p class="muted">Character-led emotional video, without a studio, a crew, or an ad budget.</p>
      </div>
      <div class="svc__grid">
        {services.map((s) => (
          <div class="svc__card">
            <span class="svc__icon">{s.icon}</span>
            <strong>{s.t}</strong>
            <p class="muted">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="section who">
    <div class="wrap section--center">
      <p class="eyebrow eyebrow--light">Who it's for</p>
      <h2 style="color:#fff">Kids & family brands · D2C · edtech · apps</h2>
      <p style="color:rgba(255,255,255,0.9); max-width:56ch; margin:0 auto;">
        Anyone who wants character-led, emotional video that people actually watch, save, and share —
        without the cost and lead-time of traditional production.
      </p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" id="how">
    <div class="wrap">
      <div class="section__head section--center">
        <p class="eyebrow">How it works</p>
        <h2>From brief to ready-to-post</h2>
      </div>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <span class="step__n">{s.n}</span>
            <strong>{s.t}</strong>
            <p class="muted">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CASE STUDY -->
  <section class="section case">
    <div class="wrap case__inner">
      <div class="case__copy">
        <p class="eyebrow">Flagship case study</p>
        <h2>Blu Baby Show</h2>
        <p class="muted">
          Our own brand — built from zero, entirely with AI, posted organically. Emotional reels that
          hit <strong>19M views</strong>, a <strong>92M+</strong> cumulative view count, and a
          <strong> 64K+</strong> community of parents. No ads. No agency. Just the pipeline we now run
          for clients.
        </p>
        <a class="btn btn--sun" href="https://instagram.com/theblubabyshow" target="_blank" rel="noopener">Watch it on Instagram ↗</a>
      </div>
      <div class="case__art">
        <img src="/characters/blu.webp" alt="Blu, the 3D animated baby from Blu Baby Show" width="300" height="300" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section contact section--center" id="contact">
    <div class="wrap">
      <p class="eyebrow">Let's talk</p>
      <h2>Let's make something that travels.</h2>
      <p class="muted" style="max-width:48ch;margin:0 auto 1.8rem;">
        Tell us about your brand and what you want to make. We reply within two business days.
      </p>
      <a class="btn btn--primary" href="mailto:blubabyshow@gmail.com?subject=Studio%20enquiry">blubabyshow@gmail.com</a>
    </div>
  </section>
</Base>

<style>
  .shero { padding-top: calc(var(--nav-h) + 2rem); background: linear-gradient(180deg, var(--sky) 0%, var(--cream) 70%); }
  .shero h1 { font-size: clamp(2.1rem, 6vw, 4rem); line-height: 1.04; margin: 0 auto 1.1rem; max-width: 16ch; }
  .shero .hl { color: var(--orange-d); }
  .shero__sub { font-size: 1.2rem; max-width: 52ch; margin: 0 auto 2rem; }
  .shero__cta { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }

  /* Proof bar */
  .proof { background: var(--blu-deep); padding: 2.2rem 0; }
  .proof__row { display: flex; justify-content: space-around; gap: 1rem; flex-wrap: wrap; }
  .proof__stat { text-align: center; color: #fff; }
  .proof__stat strong { display: block; font-family: var(--font-head); font-size: clamp(1.8rem, 5vw, 2.8rem); line-height: 1; color: var(--sun); }
  .proof__stat span { font-size: 0.92rem; opacity: 0.9; }

  /* Services */
  .svc__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem; }
  .svc__card { background: var(--paper); border-radius: var(--radius-sm); padding: 1.8rem; box-shadow: var(--shadow-soft); }
  .svc__icon { font-size: 2rem; display: block; margin-bottom: 0.7rem; }
  .svc__card strong { font-family: var(--font-head); font-size: 1.2rem; display: block; margin-bottom: 0.4rem; color: var(--blu-deep); }

  /* Who — colored band */
  .who { background: linear-gradient(135deg, var(--grape) 0%, var(--blu-d) 100%); border-radius: 0; }

  /* Steps */
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  .step { text-align: center; padding: 1.4rem 1rem; }
  .step__n { font-family: var(--font-head); font-size: 2.2rem; font-weight: 700; color: var(--sky-d); display: block; }
  .step strong { display: block; font-family: var(--font-head); font-size: 1.15rem; margin: 0.3rem 0 0.4rem; color: var(--blu-deep); }

  /* Case study */
  .case { background: var(--sand); }
  .case__inner { display: grid; grid-template-columns: 1.3fr 0.7fr; align-items: center; gap: 2.5rem; }
  .case__art { display: grid; place-items: center; }
  .case__art img { animation: floatSm 5s ease-in-out infinite; filter: drop-shadow(0 16px 20px rgba(43,44,65,0.2)); }

  /* Contact */
  .contact { background: var(--cream-2); }

  @media (max-width: 760px) {
    .svc__grid { grid-template-columns: 1fr; }
    .steps { grid-template-columns: repeat(2, 1fr); }
    .case__inner { grid-template-columns: 1fr; text-align: center; }
    .case__art { order: -1; max-width: 220px; margin: 0 auto; }
  }
</style>
