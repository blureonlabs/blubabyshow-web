---
// Pre-launch kit page (fake-door test). The Buy button logs intent and opens early access. No charge.
import Base from '../../layouts/Base.astro';
import { kits, kitBySlug } from '../../data/kits';

export function getStaticPaths() {
  return kits.map((k) => ({ params: { slug: k.slug } }));
}
const kit = kitBySlug(Astro.params.slug!)!;
const others = kits.filter((k) => k.slug !== kit.slug);
---

<Base title={`${kit.name} · Blu Baby Show`} description={kit.tagline}>
  <section class="kit" style={`--kit:${kit.accent}`}>
    <div class="kit__wrap">
      <p class="kit__eyebrow">Blu Kits · for parents of little ones</p>
      <h1>{kit.name}</h1>
      <p class="kit__tag">{kit.tagline}</p>

      <div class="kit__hero"><img src={kit.img} alt={kit.imgAlt} width="420" height="420" loading="eager" /></div>

      <div class="kit__buy">
        <p class="kit__price"><span data-price-inr={kit.inr} data-price-usd={kit.usd}>${kit.usd}</span> <small>one-time · instant access</small></p>
        <button id="buyBtn" class="kit__btn" data-slug={kit.slug} data-inr={kit.inr} data-usd={kit.usd}>Get the kit</button>
        <p class="kit__fine">Works on your phone. Printable too. Digital only: nothing is shipped.</p>

        <div id="early" class="kit__early" hidden>
          <p class="kit__early-h">Almost ready! 💛</p>
          <p>We're putting the finishing touches on <strong>{kit.name}</strong>. It opens {kit.launch}.
            Leave your email and you'll get it first, at an early-bird price, plus a free sample page today.</p>
          <form id="earlyForm" novalidate>
            <input type="email" name="email" placeholder="your@email.com" aria-label="Email address" required />
            <input type="text" name="hp" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button type="submit">Notify me + send the free page</button>
          </form>
          <p id="earlyMsg" class="kit__msg" role="status" aria-live="polite"></p>
          <p class="kit__fine">You haven't been charged. One warm email on Sundays, unsubscribe anytime.</p>
        </div>
      </div>

      <div class="kit__card">
        <h2>Why we made it</h2>
        <p>{kit.problem}</p>
      </div>

      <div class="kit__card">
        <h2>What's inside</h2>
        <ul>{kit.inside.map((i) => <li>{i}</li>)}</ul>
        <p class="kit__who"><strong>For:</strong> {kit.forWho}</p>
      </div>

      <div class="kit__card kit__how">
        <h2>How it works</h2>
        <ol>
          <li>Get the kit: you'll receive a link by email straight away.</li>
          <li>Watch the Blu video together with your little one.</li>
          <li>Read the short story at the moment it matters, using the words on each page.</li>
          <li>Tap a star each day you try. Small steps add up.</li>
        </ol>
      </div>

      <div class="kit__more">
        <h2>More Blu Kits</h2>
        <div class="kit__grid">
          {others.map((o) => (
            <a href={`/kits/${o.slug}/`} class="kit__mini" data-kit-link={o.slug}>
              <img src={o.img} alt="" width="72" height="72" loading="lazy" />
              <span>{o.name}</span>
            </a>
          ))}
        </div>
      </div>

      <p class="kit__foot">Made with love by <a href="/">Blu Baby Show</a> · <a href="/contact">Contact</a></p>
    </div>
  </section>
</Base>

<script>
  const w = window as any;
  const inIndia = (() => { try { return /Asia\/(Kolkata|Calcutta)/.test(Intl.DateTimeFormat().resolvedOptions().timeZone); } catch { return false; } })();
  document.querySelectorAll<HTMLElement>('[data-price-inr]').forEach((el) => {
    el.textContent = inIndia ? `₹${el.dataset.priceInr}` : `$${el.dataset.priceUsd}`;
  });

  const btn = document.getElementById('buyBtn') as HTMLButtonElement;
  const slug = btn.dataset.slug!;
  const price = inIndia ? Number(btn.dataset.inr) : Number(btn.dataset.usd);
  const currency = inIndia ? 'INR' : 'USD';
  const params = new URLSearchParams(location.search);
  const props = { kit: slug, price, currency, utm_source: params.get('utm_source'), utm_campaign: params.get('utm_campaign'), utm_content: params.get('utm_content') };

  w.posthog?.capture?.('kit_view', props);
  btn.addEventListener('click', () => {
    w.posthog?.capture?.('kit_buy_click', props);
    w.fbq?.('track', 'InitiateCheckout', { content_name: slug, value: price, currency });
    btn.hidden = true;
    const early = document.getElementById('early')!;
    early.hidden = false;
    early.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  const form = document.getElementById('earlyForm') as HTMLFormElement;
  const msg = document.getElementById('earlyMsg')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.querySelector('input[type=email]') as HTMLInputElement).value.trim();
    const hp = (form.querySelector('input[name=hp]') as HTMLInputElement).value;
    const b = form.querySelector('button') as HTMLButtonElement;
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.textContent = 'Please enter a valid email 💛'; return; }
    b.disabled = true; b.textContent = 'Sending…';
    try {
      const res = await fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, source: `kit-waitlist:${slug}`, hp }) });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        form.style.display = 'none';
        msg.innerHTML = "You're on the list! 💛 We've emailed you. Here's a free page to start: <a href='/free/blu-feelings-cards-A4.pdf' download>Blu's Feelings Cards (PDF)</a>.";
        w.posthog?.capture?.('kit_waitlist', props);
        w.fbq?.('track', 'Lead', { content_name: `kit-${slug}` });
      } else {
        msg.textContent = data.error || 'Something went wrong, please try again.';
        b.disabled = false; b.textContent = 'Notify me + send the free page';
      }
    } catch {
      msg.textContent = 'Network hiccup, please try again.';
      b.disabled = false; b.textContent = 'Notify me + send the free page';
    }
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-kit-link]').forEach((a) =>
    a.addEventListener('click', () => w.posthog?.capture?.('kit_cross_click', { from: slug, to: a.dataset.kitLink })));
</script>

<style>
  .kit { padding: calc(var(--nav-h, 64px) + 1.5rem) 16px 3rem; background: #FBF3E7; }
  .kit__wrap { max-width: 560px; margin: 0 auto; }
  .kit__eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: .78rem; color: #6b6c85; margin: 0; text-align: center; }
  .kit h1 { text-align: center; font-size: clamp(1.8rem, 6vw, 2.4rem); margin: .3rem 0; }
  .kit__tag { text-align: center; color: #4a4b66; font-size: 1.08rem; margin: 0 0 1rem; }
  .kit__hero { background: var(--kit); border-radius: 28px; padding: 1.2rem; text-align: center; }
  .kit__hero img { width: min(260px, 70%); height: auto; }
  .kit__buy { background: #fff; border-radius: 22px; padding: 1.2rem; margin: -1.2rem 1rem 1rem; position: relative; box-shadow: 0 8px 24px rgba(34,58,92,.12); text-align: center; }
  .kit__price { font-size: 1.9rem; font-weight: 800; margin: 0 0 .6rem; color: #223a5c; }
  .kit__price small { display: block; font-size: .85rem; font-weight: 500; color: #6b6c85; }
  .kit__btn, .kit__early button { width: 100%; padding: 1rem; border: 0; border-radius: 999px; background: #30598a; color: #fff; font-weight: 800; font-size: 1.1rem; cursor: pointer; }
  .kit__btn:hover { filter: brightness(1.08); }
  .kit__fine { font-size: .8rem; color: #6b6c85; margin: .6rem 0 0; }
  .kit__early { text-align: left; }
  .kit__early-h { font-size: 1.3rem; font-weight: 800; margin: 0 0 .3rem; color: #30598a; }
  .kit__early form { display: flex; flex-direction: column; gap: .5rem; margin-top: .7rem; }
  .kit__early input[type=email] { padding: .85rem 1rem; border-radius: 999px; border: 2px solid #d6e4f0; font-size: 1rem; }
  .kit__msg { font-weight: 600; color: #30598a; }
  .kit__msg a { text-decoration: underline; }
  .hp { position: absolute; left: -9999px; }
  .kit__card { background: #fff; border-radius: 20px; padding: 1.1rem 1.2rem; margin-bottom: .9rem; box-shadow: 0 4px 16px rgba(34,58,92,.06); }
  .kit__card h2, .kit__more h2 { font-size: 1.2rem; margin: 0 0 .5rem; }
  .kit__card ul, .kit__card ol { margin: 0; padding-left: 1.2rem; }
  .kit__card li { margin: .35rem 0; }
  .kit__who { margin: .8rem 0 0; color: #4a4b66; }
  .kit__more { margin-top: 1.4rem; }
  .kit__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .7rem; }
  .kit__mini { display: flex; align-items: center; gap: .6rem; background: #fff; border-radius: 16px; padding: .6rem; color: inherit; text-decoration: none; font-weight: 700; font-size: .92rem; }
  .kit__mini img { width: 48px; height: 48px; object-fit: contain; border-radius: 12px; background: #eef5fb; flex: none; }
  .kit__foot { text-align: center; font-size: .85rem; color: #6b6c85; margin-top: 1.6rem; }
  .kit__foot a { color: inherit; }
</style>
