---
import Base from '../layouts/Base.astro';
import Doodles from '../components/Doodles.astro';
import Icon from '../components/Icon.astro';

/* ------------------------------------------------------------------
   PHASE 0 — "Blu's Sunny World" homepage.
   Warm and catchy. Character-first, bright, joyful.
   Doubles as the link-in-bio destination: convert the 165K/mo IG
   profile-visit click into an owned email or a revenue action.
   Swap the placeholder character PNGs (same filenames) as better
   art is generated. TODO(studio): read published content from Supabase.
------------------------------------------------------------------ */

const pillars = [
  { title: 'Big Feelings', blurb: 'Cinematic little moments about the feelings of raising a tiny human.', c: 'var(--orange)', icon: 'heart' },
  { title: 'Learn with Blu', blurb: 'Colours, numbers, animals and feelings, as picture carousels to explore together.', c: 'var(--grass)', icon: 'book' },
  { title: 'Blu vs the World', blurb: 'Tiny-chaos comedy. Bubble wrap. Mirrors. Mum’s lipstick.', c: 'var(--sun)', icon: 'smile' },
  { title: 'Family Life', blurb: 'Warm slice-of-life — scooter rides, monsoons, rooftop sunsets.', c: 'var(--grape)', icon: 'home' },
];

const hub = [
  { label: 'Watch the newest episode', sub: 'New every week', href: 'https://instagram.com/theblubabyshow', c: 'var(--blu)', icon: 'play' },
  { label: 'Get Blu’s free letters', sub: 'For parents · free printables when ready', href: '#newsletter', c: 'var(--sun)', icon: 'mail' },
  { label: 'Watch on the big screen', sub: 'Subscribe on YouTube', href: 'https://youtube.com/@blubabyshow', c: 'var(--sky)', icon: 'tv' },
  { label: 'For brands', sub: 'Work with the studio behind Blu', href: '/studio/', c: 'var(--grass)', icon: 'sparkle' },
];

const family = [
  { img: '/characters/blu.webp',    name: 'Blu',    tag: 'the little mischief', c: 'var(--blu)' },
  { img: '/characters/mom.webp',    name: 'Mum',    tag: 'keeps it all together', c: 'var(--pink)' },
  { img: '/characters/dad.webp',    name: 'Dad',    tag: 'always shows up', c: 'var(--sky)' },
  { img: '/characters/puppy.webp',  name: 'Puppy',  tag: 'clumsy & kind', c: 'var(--sun)' },
  { img: '/characters/sister.webp', name: 'Sister', tag: 'the quiet one', c: 'var(--grape)' },
];
---

<Base>
  <!-- ============ HERO — welcome card over a full family scene ============ -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__card reveal d1">
        <p class="eyebrow">Welcome to the home of Blu</p>
        <h1>The happiest <br /><span class="hero__pop">little show</span> <br />for real families.</h1>
        <p class="hero__sub">
          Warm, giggly little stories that help your little one name big feelings —
          and make the long days a little softer. Watched <strong>85M+</strong> times
          on Instagram.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="https://instagram.com/theblubabyshow">Watch Blu on Instagram</a>
          <a class="btn btn--sun" href="#newsletter">Get the free newsletter</a>
        </div>
        <div class="hero__stats">
          <span><b>85M+</b> views on Instagram</span>
          <span class="dotsep">·</span>
          <span><b>64K</b> followers</span>
          <span class="dotsep">·</span>
          <span>New episodes <b>every week</b></span>
        </div>
      </div>
    </div>

    <div class="hero__scene">
      <img src="/characters/family_hero.webp"
           alt="Blu with Mum, Dad, the puppy and baby sister"
           width="1024" height="1024" fetchpriority="high" />
    </div>
  </section>

  <!-- ============ STATS MARQUEE ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {Array.from({ length: 2 }).map(() => (
        <span class="marquee__row">
          <b>85M+ views</b> ★ <b>64K followers</b> ★ <b>followed in 45+ countries</b> ★
          <b>new episodes every week</b> ★ <b>feelings before facts</b> ★
        </span>
      ))}
    </div>
  </div>

  <!-- ============ LINK HUB ============ -->
  <section class="section hub-sec">
    <div class="wrap">
      <div class="section__head section--center">
        <p class="eyebrow">Start here</p>
        <h2>Where do you want to go?</h2>
      </div>
      <div class="hub">
        {hub.map((l, i) => (
          <a class={`hub__card tilt${i % 2}`} href={l.href} style={`--c:${l.c}`}>
            <span class="hub__ic"><Icon name={l.icon} size={22} /></span>
            <span class="hub__t">
              <span class="hub__label">{l.label}</span>
              <span class="hub__sub">{l.sub}</span>
            </span>
            <span class="hub__arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ NEWSLETTER (primary conversion) ============ -->
  <section class="section news" id="newsletter">
    <Doodles variant="sparse" />
    <div class="wrap news__card">
      <div class="news__copy">
        <p class="eyebrow eyebrow--light"><Icon name="mail" size={16} /> Letters from Blu’s family</p>
        <h2>Gentle notes for tired parents. Free.</h2>
        <p class="news__lead">
          The newest Blu episode, a short note for the long days, and free printables when
          they’re ready. For grown-ups (18+). Unsubscribe anytime.
        </p>
        <form class="news__form" id="newsForm" novalidate>
          <input class="news__input" type="email" name="email" placeholder="your@email.com" aria-label="Email address" required />
          <input type="text" name="hp" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn btn--sun" type="submit">Send me Blu’s letters</button>
        </form>
        <p class="news__msg" id="newsMsg" role="status" aria-live="polite"></p>
        <p class="news__fine">We only use your email to send these letters and never sell it. <a href="/privacy">Privacy Policy</a></p>
      </div>
      <div class="news__art" aria-hidden="true">
        <img loading="lazy" decoding="async" class="sticker" src="/characters/mom.webp" alt="" width="240" height="240" />
        <span class="news__stamp">FREE<br />letters</span>
      </div>
    </div>
  </section>

  <!-- ============ PILLARS ============ -->
  <section class="section section--center" id="watch">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow">What we make</p>
        <h2>Four kinds of Blu</h2>
        <p class="muted">New episodes every week: feelings, learning, laughs and family.</p>
      </div>
      <div class="pillars">
        {pillars.map((p, i) => (
          <a class={`pill tilt${i % 2}`} href="https://instagram.com/theblubabyshow" style={`--c:${p.c}`}>
            <span class="pill__emoji"><Icon name={p.icon} size={26} /></span>
            <h3>{p.title}</h3>
            <p class="muted">{p.blurb}</p>
            <span class="pill__go">See more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ MEET THE FAMILY ============ -->
  <section class="section fam" id="story">
    <div class="wrap">
      <div class="section__head section--center">
        <p class="eyebrow" style="color:#fff">The whole gang</p>
        <h2 style="color:#fff">Meet Blu’s family</h2>
      </div>
      <div class="fam__row">
        {family.map((m) => (
          <div class="fam__card" style={`--c:${m.c}`}>
            <div class="fam__ph"><img loading="lazy" decoding="async" src={m.img} alt={m.name} width="150" height="150" /></div>
            <strong>{m.name}</strong>
            <span>{m.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ LEARN ============ -->
  <section class="section learn" id="learn">
    <div class="wrap learn__grid">
      <div class="learn__art">
        <span class="learn__blob" aria-hidden="true"></span>
        <img loading="lazy" decoding="async" class="sticker" src="/characters/puppy.webp" alt="Blu’s puppy learning with blocks" width="340" height="340" />
      </div>
      <div class="learn__copy">
        <p class="eyebrow">Learn with Blu</p>
        <h2>Little lessons to explore together.</h2>
        <p class="muted">
          Colours, numbers, animals and feelings: gentle picture carousels for grown-ups to
          share with little ones. Printable packs are coming soon. Join the list and we’ll
          send the first one free.
        </p>
        <a class="btn btn--grass" href="#newsletter">Join the list →</a>
      </div>
    </div>
  </section>

  <!-- ============ PRINTABLES (waitlist) ============ -->
  <section class="section shop" id="printables">
    <div class="wrap shop__grid">
      <div class="shop__cover">
        <img loading="lazy" decoding="async" class="sticker" src="/characters/blu_book.webp" alt="Blu holding up a colouring book" width="300" height="300" />
      </div>
      <div class="shop__copy">
        <p class="eyebrow">Coming soon</p>
        <h2>Blu’s printable activity packs</h2>
        <p class="muted">
          Feelings cards, colouring pages and first-word games starring Blu and his family.
          Join the waitlist and we’ll send the first pack free when it’s ready.
        </p>
        <a class="btn btn--primary" href="#newsletter">Join the waitlist</a>
      </div>
    </div>
  </section>

  <!-- ============ CLOSING CTA ============ -->
  <section class="section closing section--center">
    <Doodles variant="hero" />
    <div class="wrap">
      <div class="closing__cast" aria-hidden="true">
        <span class="cast cast--puppy"><img loading="lazy" decoding="async" src="/characters/puppy.webp" alt="" width="150" height="150" /></span>
        <span class="cast cast--mom"><img loading="lazy" decoding="async" src="/characters/mom.webp" alt="" width="150" height="150" /></span>
        <span class="cast cast--blu"><img loading="lazy" decoding="async" src="/characters/blu.webp" alt="" width="150" height="150" /></span>
        <span class="cast cast--dad"><img loading="lazy" decoding="async" src="/characters/dad.webp" alt="" width="150" height="150" /></span>
        <span class="cast cast--sister"><img loading="lazy" decoding="async" src="/characters/sister.webp" alt="" width="150" height="150" /></span>
      </div>
      <h2>Come hang out with Blu every week.</h2>
      <p class="muted closing__sub">Free, warm, and made with love — new little episodes every single week.</p>
      <div class="closing__cta">
        <a class="btn btn--primary" href="https://instagram.com/theblubabyshow">Follow on Instagram</a>
        <a class="btn btn--sun" href="#newsletter">Get Blu’s free letters</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('newsForm');
  const msg = document.getElementById('newsMsg');
  if (form && msg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[type=email]');
      const btn = form.querySelector('button');
      const email = (input?.value || '').trim();
      const hp = form.querySelector('input[name=hp]')?.value || '';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.textContent = 'Please enter a valid email 💛';
        msg.className = 'news__msg news__msg--err';
        return;
      }
      const label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'website', hp }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.style.display = 'none';
          msg.textContent = "You're in! 💛 Thanks for joining Blu's letters.";
          msg.className = 'news__msg news__msg--ok';
          // Conversion event (PostHog) — only fires on a real success. No-op if PH is off.
          window.posthog?.capture?.('newsletter_signup', { source: 'website' });
        } else {
          msg.textContent = data.error || 'Something went wrong — please try again.';
          msg.className = 'news__msg news__msg--err';
          btn.disabled = false; btn.textContent = label;
          // Failure event (PostHog) so a broken signup backend shows up in analytics. No-op if PH is off.
          window.posthog?.capture?.('newsletter_signup_failed', { status: res.status });
        }
      } catch {
        msg.textContent = 'Network hiccup — please try again.';
        msg.className = 'news__msg news__msg--err';
        btn.disabled = false; btn.textContent = label;
        // status 0 = network error (no HTTP response)
        window.posthog?.capture?.('newsletter_signup_failed', { status: 0 });
      }
    });
  }
</script>

<style>
  /* ---------- HERO — welcome card over family scene ---------- */
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--nav-h));
    padding-top: calc(var(--nav-h) + clamp(0.6rem, 2vw, 1.4rem));
    background: linear-gradient(180deg, #8ecbfb 0%, #6fbdf2 55%, #53ace4 100%);
    overflow: hidden;
  }
  .hero__card {
    position: relative; z-index: 2;
    max-width: 620px; margin: 0 auto;
    background: #fff; border-radius: var(--radius);
    padding: clamp(1.7rem, 4vw, 2.9rem) clamp(1.5rem, 4vw, 3rem);
    text-align: center;
    box-shadow: var(--shadow);
    border: 4px solid #fff;
  }
  .hero__card .eyebrow { justify-content: center; }
  .hero__card h1 { font-size: clamp(2.05rem, 5.6vw, 3.35rem); line-height: 1.04; margin-bottom: 0.5rem; }
  .hero__pop {
    color: var(--orange); position: relative; display: inline-block;
  }
  .hero__pop::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 4px; height: 12px;
    background: var(--sun); border-radius: 8px; z-index: -1; transform: rotate(-1deg);
  }
  .hero__sub { font-size: 1.12rem; max-width: 46ch; margin: 0.5rem auto 0; color: var(--ink-soft); }
  .hero__cta { display: flex; gap: 0.8rem; flex-wrap: wrap; justify-content: center; margin: 1.6rem 0 1.3rem; }
  .hero__stats { display: flex; align-items: center; justify-content: center; gap: 0.8rem; color: var(--ink-soft); font-size: 0.96rem; }
  .hero__stats b { font-family: var(--font-head); color: var(--blu-deep); }
  .dotsep { color: var(--sky-d); }

  .hero__scene { position: relative; z-index: 1; margin-top: -1.4rem; }
  .hero__scene img {
    width: min(760px, 94%); height: auto; display: block; margin: 0 auto;
    object-fit: contain;
    filter: drop-shadow(0 24px 34px rgba(58, 33, 28, 0.18));
  }

  /* ---------- MARQUEE ---------- */
  .marquee {
    background: var(--blu-deep); color: #fff; overflow: hidden;
    padding: 0.7rem 0; border-top: 4px solid rgba(255,255,255,0.15);
  }
  .marquee__track { display: flex; width: max-content; animation: marquee 26s linear infinite; }
  .marquee__row {
    font-family: var(--font-head); font-weight: 600; font-size: 1.05rem;
    white-space: nowrap; padding-right: 1rem; display: inline-flex; gap: 0.6rem;
  }
  .marquee__row b { font-weight: 600; }

  /* ---------- HUB ---------- */
  .hub-sec { background: var(--base); }
  .hub { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.3rem; max-width: 940px; margin: 0 auto; }
  .hub__card {
    display: flex; align-items: center; gap: 1.1rem;
    background: var(--c); color: #fff; border-radius: var(--radius);
    padding: 1.5rem 1.6rem;
    border: 3px solid #fff;
    box-shadow: 0 10px 0 -1px color-mix(in srgb, var(--c), #000 24%), var(--shadow-soft);
    transition: transform 0.16s cubic-bezier(.34,1.56,.64,1), box-shadow 0.16s ease;
  }
  .hub__card:hover { transform: translateY(-5px) rotate(-1deg); box-shadow: 0 14px 0 -1px color-mix(in srgb, var(--c), #000 24%), var(--shadow); }
  .hub__ic {
    flex: none; width: 54px; height: 54px; border-radius: 16px;
    background: rgba(255,255,255,0.92); color: var(--c); display: grid; place-items: center;
    box-shadow: inset 0 -4px 0 rgba(0,0,0,0.08);
  }
  .hub__t { display: flex; flex-direction: column; line-height: 1.25; flex: 1; }
  .hub__label { font-family: var(--font-head); font-weight: 700; font-size: 1.1rem; }
  .hub__sub { font-size: 0.86rem; color: rgba(255,255,255,0.85); }
  .hub__arrow { font-family: var(--font-head); font-weight: 700; font-size: 1.4rem; color: #fff; }
  .hub__card:last-child:nth-child(odd) { grid-column: 1 / -1; }

  .tilt0 { transform: rotate(-0.6deg); }
  .tilt1 { transform: rotate(0.6deg); }
  .tilt0:hover, .tilt1:hover { transform: translateY(-4px) rotate(0); }

  /* honey card needs dark text for contrast (matches .btn--sun) */
  .hub__card[style*="--sun"] .hub__label,
  .hub__card[style*="--sun"] .hub__sub,
  .hub__card[style*="--sun"] .hub__arrow { color: #5a3d00; }
  .hub__card[style*="--sun"] .hub__sub { color: #7a5a12; }
  .hub__card[style*="--sun"] .hub__ic { color: var(--sun-d); }

  /* ---------- NEWSLETTER ---------- */
  .news { position: relative; background: var(--base); }
  .news__card {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: 1.5fr 0.8fr; align-items: center; gap: 2rem;
    background: linear-gradient(135deg, var(--orange) 0%, var(--orange-d) 100%);
    color: #fff; border-radius: var(--radius); padding: clamp(2rem, 4vw, 3.2rem);
    box-shadow: var(--shadow); overflow: hidden;
  }
  .news h2 { color: #fff; }
  .news__lead { color: rgba(255,255,255,0.9); max-width: 46ch; }
  .news__form { display: flex; gap: 0.6rem; margin: 1.4rem 0 0.7rem; flex-wrap: wrap; }
  .news__input {
    flex: 1; min-width: 220px; padding: 0.9rem 1.2rem; border-radius: 999px;
    border: 0; background: rgba(255,255,255,0.95); color: var(--ink);
    font-size: 1rem; font-family: var(--font-body);
  }
  .news__input:focus { outline: 3px solid var(--sun); }
  .news__fine { font-size: 0.8rem; color: rgba(255,255,255,0.75); margin: 0; }
  .news__fine a { text-decoration: underline; }
  .news__art { position: relative; display: grid; place-items: center; }
  .news__art img { width: 240px; height: 240px; border-radius: 50%; background: rgba(255,255,255,0.16); object-fit: cover; object-position: 50% 14%; }
  .news__stamp {
    position: absolute; right: -4px; bottom: 6px;
    background: var(--sun); color: #5a3d00;
    font-family: var(--font-head); font-weight: 700; font-size: 0.8rem; text-align: center;
    line-height: 1.05; padding: 0.7rem; border-radius: 50%;
    transform: rotate(-10deg); box-shadow: var(--shadow-sticker);
  }

  /* ---------- PILLARS ---------- */
  .pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; }
  .pill {
    background: #fff; border-radius: var(--radius); padding: 1.6rem 1.35rem;
    box-shadow: var(--shadow-soft); border-bottom: 6px solid var(--c);
    display: flex; flex-direction: column; gap: 0.3rem; text-align: left;
    transition: transform 0.16s cubic-bezier(.34,1.56,.64,1), box-shadow 0.16s ease;
  }
  .pill:hover { transform: translateY(-6px) rotate(0); box-shadow: var(--shadow); }
  .pill__emoji {
    width: 56px; height: 56px; border-radius: 16px; background: color-mix(in srgb, var(--c) 20%, #fff);
    display: grid; place-items: center; margin-bottom: 0.7rem;
    color: color-mix(in srgb, var(--c), var(--ink) 35%);
  }
  .pill h3 { font-size: 1.15rem; }
  .pill p { font-size: 0.9rem; }
  .pill__go { margin-top: auto; font-family: var(--font-head); font-weight: 600; color: var(--ink); font-size: 0.92rem; }

  /* ---------- MEET THE FAMILY ---------- */
  .fam { background: linear-gradient(180deg, var(--blu) 0%, var(--blu-deep) 100%); }
  .fam__row { display: flex; justify-content: center; gap: 1.3rem; flex-wrap: wrap; }
  .fam__card {
    background: #fff; border-radius: var(--radius); padding: 1.5rem 1.1rem 1.6rem;
    width: 178px; text-align: center; box-shadow: var(--shadow-soft);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .fam__card:hover { transform: translateY(-6px) rotate(-2deg); box-shadow: var(--shadow); }
  .fam__card strong { display: block; font-family: var(--font-head); font-size: 1.25rem; margin-top: 0.8rem; color: var(--blu-deep); }
  .fam__card span {
    display: inline-block; margin-top: 0.4rem;
    font-family: var(--font-head); font-size: 0.78rem; font-weight: 600;
    color: color-mix(in srgb, var(--c), var(--ink) 32%);
    background: color-mix(in srgb, var(--c) 16%, #fff);
    padding: 0.22rem 0.75rem; border-radius: 999px;
  }
  .fam__ph {
    width: 134px; height: 134px; margin: 0 auto; border-radius: 50%;
    background: color-mix(in srgb, var(--c) 22%, #fff);
    display: grid; place-items: center; overflow: hidden;
  }
  .fam__ph img { width: 122px; height: 122px; object-fit: contain; }

  /* ---------- LEARN ---------- */
  .learn { background: var(--base); }
  .learn__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; align-items: center; gap: 2.5rem; }
  .learn__art { position: relative; display: grid; place-items: center; }
  .learn__blob {
    position: absolute; width: 82%; aspect-ratio: 1;
    background: radial-gradient(circle, var(--grass) 0%, #b6e6b3 60%, rgba(182,230,179,0) 72%);
    border-radius: 46% 54% 58% 42% / 52% 44% 56% 48%; opacity: 0.5;
  }
  .learn__art img { position: relative; z-index: 1; animation: floatSm 5s ease-in-out infinite; }

  /* ---------- PRINTABLES (waitlist) ---------- */
  .shop { background: var(--base); }
  .shop__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; align-items: center; gap: 2.5rem; }
  .shop__cover {
    position: relative; background: linear-gradient(160deg, var(--sun) 0%, var(--orange) 100%);
    border-radius: var(--radius); padding: 2.4rem; display: grid; place-items: center;
    max-width: 360px; margin: 0 auto; box-shadow: var(--shadow);
  }
  .shop__cover img { animation: floatSm 5s ease-in-out infinite; }

  /* ---------- CLOSING ---------- */
  .closing { position: relative; background: linear-gradient(180deg, #d6ecff 0%, var(--sky) 100%); overflow: hidden; }
  /* Scattered family cluster — Blu center + Mum/Dad/Puppy/Sister around, gently floating */
  .closing__cast {
    position: relative; z-index: 2;
    display: flex; justify-content: center; align-items: flex-end;
    gap: clamp(0.1rem, 1.5vw, 0.8rem);
    max-width: 600px; margin: 0 auto 1.2rem;
  }
  .closing__cast .cast { display: block; }
  .closing__cast img {
    width: 100%; height: auto; display: block;
    filter: drop-shadow(0 12px 12px rgba(43, 44, 65, 0.18));
    animation: floatSm 5s ease-in-out infinite;
  }
  /* sizes + scatter offsets/rotations (on the wrapper so they don't fight the float animation) */
