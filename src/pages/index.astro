---
// Blululu home (17 Nov 2026): "A · Bold red" from the founder's design canvas.
// Order: hero + proof + shop by moment · what we make · BluBabyShow · how a printable works ·
// newsletter + slogan · moments wall · watch / play / shop.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Newsletter from '../components/Newsletter.astro';
import { bySlug } from '../data/products';

const meltdown = bySlug('meltdown-scripts')!;
const colouring = bySlug('colouring-pack')!;
const abc = bySlug('abc-book')!;
const bundle = bySlug('colouring-abc-bundle')!;

/* Real numbers only. 92M+ = lifetime Instagram views of BluBabyShow (Graph API, 14 Nov 2026). */
const proof = [
  { big: '92M+', small: 'views of BluBabyShow' },
  { big: '₹ / $', small: 'pay in your own currency' },
  { big: 'Instant', small: 'PDF download after checkout' },
  { big: '7-day', small: 'refund on every Original' },
];

const moments = [
  { label: 'Big feelings', href: `/shop/${meltdown.slug}/`, img: meltdown.img, bg: '#FFE3E9' },
  { label: 'Colouring & play', href: `/shop/${colouring.slug}/`, img: colouring.img, bg: '#FFF1D6' },
  { label: 'Learning & ABC', href: `/shop/${abc.slug}/`, img: abc.img, bg: '#E4F2FB' },
  { label: 'Bundles & gifts', href: `/shop/${bundle.slug}/`, img: bundle.img, bg: '#F4EEEA' },
  { label: 'Kits (coming soon)', href: '/kits/', img: '/characters/puppy.webp', bg: 'var(--red)', cut: true },
];

const make = [
  { n: '01', tag: 'Scripts', name: 'Meltdown scripts', p: meltdown },
  { n: '02', tag: 'Printables', name: 'Colouring pack', p: colouring },
  { n: '03', tag: 'Learning', name: 'Blu ABC book', p: abc },
];

const steps = [
  { n: '01', t: 'Pick a moment', d: 'Meltdowns, a new baby, first letters. Find the pack made for it.' },
  { n: '02', t: 'Download instantly', d: 'Pay in ₹ or your own currency. The PDF is ready the moment you pay.' },
  { n: '03', t: 'Print and play', d: 'Print at home as often as you like, with Blu and his family as your little one’s guide.' },
];

const IG = 'https://www.instagram.com/theblubabyshow/';
const YT = 'https://www.youtube.com/@blubabyshow';
type Tile = { kind: 'art' | 'ig' | 'yt'; img?: string; label?: string; sub?: string; href: string; bg: string; h: number; cover?: boolean };
/* The colour-wall pattern from the canvas, filled with moments and products instead of the family. */
const wall: Tile[] = [
  { kind: 'art', img: '/characters/mom.webp', label: 'Big feelings', sub: '20 calm scripts', href: `/shop/${meltdown.slug}/`, bg: '#FADDE4', h: 300 },
  { kind: 'art', img: '/characters/puppy.webp', label: 'Colouring & play', sub: '79 pages to print', href: `/shop/${colouring.slug}/`, bg: '#FBEBB5', h: 240 },
  { kind: 'ig', href: IG, bg: 'var(--red)', h: 220 },
  { kind: 'art', img: '/characters/blu.webp', label: 'First letters', sub: 'A to Z with Blu', href: `/shop/${abc.slug}/`, bg: '#DCEEFB', h: 300 },
  { kind: 'art', img: '/characters/sister.webp', label: 'New baby sibling', sub: 'Kit: join the waitlist', href: '/kits/new-sibling/', bg: '#E5DDF8', h: 280 },
  { kind: 'yt', href: YT, bg: '#211C19', h: 240 },
  { kind: 'art', img: '/characters/dad.webp', label: 'Bedtime', sub: 'Kit: join the waitlist', href: '/kits/bedtime/', bg: '#D6F0DD', h: 320 },
  { kind: 'art', img: '/characters/blu_book.webp', label: 'Free printables', sub: 'Feelings Cards, free', href: '#newsletter', bg: '#FADDE4', h: 240 },
];

const cards = [
  { t: 'Watch', href: '/blubabyshow/', img: '/characters/blu.webp', bg: '#8FD0F5' },
  { t: 'Play', href: `/shop/${colouring.slug}/`, img: '/characters/puppy.webp', bg: '#FFC94D' },
  { t: 'Shop', href: '/shop/', img: colouring.img, bg: 'var(--red)', cover: true },
];
---

<Base>
  <!-- 1 · HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--light">From the makers of BluBabyShow</p>
        <h1 class="display hero__h">Engineering childhood.</h1>
        <p class="hero__sub">Stories, printables and kits for the big little moments: feelings, new siblings, bedtime and play.</p>
        <div class="hero__cta">
          <a class="btn btn--light" href="/shop/">Shop Originals</a>
          <a class="btn btn--ghost-light" href="/blubabyshow/">Meet BluBabyShow</a>
        </div>
      </div>
      <div class="hero__art">
        <img src="/characters/family_hero_clean.webp" alt="Blu with Mum, Dad, his baby sister and Puppy" width="1024" height="1024" fetchpriority="high" />
      </div>
    </div>
  </section>

  <div class="proof">
    <ul class="wrap proof__row">
      {proof.map((p) => <li><b>{p.big}</b><span>{p.small}</span></li>)}
    </ul>
  </div>

  <!-- 1b · SHOP BY MOMENT -->
  <section class="section moments">
    <div class="wrap">
      <h2 class="moments__h">Shop by <em>moment</em></h2>
      <div class="moments__grid">
        {moments.map((m) => (
          <a class="mtile" href={m.href}>
            <span class={`mtile__img ${m.cut ? 'mtile__img--cut' : ''}`} style={`background:${m.bg}`}>
              <img src={m.img} alt="" width="800" height="800" loading="lazy" decoding="async" />
            </span>
            <span class="mtile__label">{m.label}</span>
          </a>
        ))}
        <a class="mtile" href="/shop/">
          <span class="mtile__img mtile__img--all"><span>All products</span><Icon name="arrow" size={26} /></span>
          <span class="mtile__label">See everything</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2 · WHAT WE MAKE -->
  <section class="section make">
    <div class="wrap">
      <h2 class="display make__h">What we <em>make</em></h2>
      <div class="make__row">
        {make.map((m) => (
          <a class="mcard" href={`/shop/${m.p.slug}/`}>
            <span class="pill">{m.n} · {m.tag}</span>
            <img class="mcard__img" src={m.p.img} alt={m.p.imgAlt} width="800" height="800" loading="lazy" decoding="async" />
            <span class="mcard__name">{m.name}</span>
            <span class="mcard__foot"><span data-price-inr={m.p.inr} data-price-usd={m.p.usd}>₹{m.p.inr}</span><Icon name="arrow" size={18} /></span>
          </a>
        ))}
        <a class="mcard mcard--soon" href="/kits/">
          <span class="pill pill--white">04 · Coming soon</span>
          <span class="mcard__soon display">Kits for big little moments</span>
          <span class="mcard__foot"><span class="mcard__wait">Join waitlist</span><Icon name="arrow" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3 · BLUBABYSHOW -->
  <section class="section show">
    <div class="wrap">
      <div class="show__panel">
        <img class="show__art" src="/characters/blu.webp" alt="Blu, waving" width="800" height="800" loading="lazy" decoding="async" />
        <div class="show__copy">
          <p class="eyebrow show__eye">A Blululu show</p>
          <h2 class="show__h">BluBabyShow</h2>
          <p class="show__lead">Every episode teaches feelings before it teaches facts.</p>
          <p>Blu, Mum, Dad, baby Sister, Puppy and his rabbit Nini. Small everyday moments every family knows.</p>
          <div class="show__cta">
            <a class="btn show__btn" href={IG} target="_blank" rel="noopener"><Icon name="instagram" size={18} />Watch on Instagram</a>
            <a class="btn show__btn show__btn--ghost" href={YT} target="_blank" rel="noopener"><Icon name="youtube" size={18} />Watch on YouTube</a>
          </div>
          <a class="show__more" href="/blubabyshow/">Meet the family and the most-watched episodes <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · HOW A PRINTABLE WORKS -->
  <section class="section how">
    <div class="wrap">
      <h2 class="how__h">How a Blululu printable works</h2>
      <ol class="how__row">
        {steps.map((s) => (
          <li class="how__step">
            <span class="how__n">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5 · NEWSLETTER + SLOGAN -->
  <Newsletter source="website" />
  <div class="slogan">
    <div class="wrap slogan__row">
      <svg viewBox="0 0 60 20" aria-hidden="true"><path d="M2 14 C 20 12, 34 10, 46 9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M50 9 l3-6 2 6 6 2-6 2-2 6-3-6-6-2z" fill="currentColor"/></svg>
      <p class="soft">Feelings first. Always.</p>
    </div>
  </div>

  <!-- 6 · MOMENTS WALL (colour masonry) -->
  <section class="section wallsec">
    <div class="wrap">
      <div class="section__head section--center">
        <h2 class="soft wallsec__h">Find your moment</h2>
        <p>Small everyday moments. Big feelings.</p>
      </div>
      <div class="wall">
        {wall.map((t) => t.kind === 'art' ? (
          <a class="wt" href={t.href} style={`background:${t.bg};--h:${t.h}px`}>
            <img src={t.img} alt="" width="800" height="800" loading="lazy" decoding="async" />
            <span class="wt__label"><b>{t.label}</b><small>{t.sub}</small></span>
          </a>
        ) : (
          <a class="wt wt--link" href={t.href} target="_blank" rel="noopener" style={`background:${t.bg};--h:${t.h}px`}>
            <span class="wt__small">Join us on</span>
            <span class="wt__big soft">{t.kind === 'ig' ? 'Instagram' : 'YouTube'}</span>
            <span class={`wt__btn ${t.kind === 'yt' ? 'wt__btn--red' : ''}`}><Icon name={t.kind === 'ig' ? 'instagram' : 'play'} size={18} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 · WATCH / PLAY / SHOP -->
  <section class="section wps">
    <div class="wrap wps__row">
      {cards.map((c) => (
        <a class="wcard" href={c.href} style={`background:${c.bg}`}>
          <img class={c.cover ? 'wcard__cover' : 'wcard__cut'} src={c.img} alt="" width="800" height="800" loading="lazy" decoding="async" />
          <span class="wcard__t soft">{c.t}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<script>
  // Local currency for shown prices (same rule as the shop: India time zone = ₹, else $).
  const inIndia = (() => { try { return /Asia\/(Kolkata|Calcutta)/.test(Intl.DateTimeFormat().resolvedOptions().timeZone); } catch { return true; } })();
  document.querySelectorAll<HTMLElement>('[data-price-inr]').forEach((el) => {
    el.textContent = inIndia ? `₹${el.dataset.priceInr}` : `$${el.dataset.priceUsd}`;
  });
</script>

<style>
  /* 1 · hero */
  .hero { background: var(--red); color: #fff; overflow: hidden; }
  .hero__grid { display: grid; gap: 1.2rem; padding-top: 2.6rem; }
  .hero__h { color: #fff; font-size: clamp(2.3rem, 10.4vw, 6.4rem); margin-bottom: 0.3em; }
  .hero__sub { font-size: 1.08rem; font-weight: 600; max-width: 34ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 1.4rem; }
  .hero__cta .btn { flex: 1 1 100%; }
  .hero__art img { width: 100%; max-width: 560px; margin: 0 auto; }
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: end; padding-top: 3.5rem; }
    .hero__h { font-size: clamp(3.6rem, 6.4vw, 5.6rem); }
    .hero__copy { padding-bottom: 4rem; }
    .hero__cta .btn { flex: 0 0 auto; }
    .hero__art { margin-right: -2rem; }
  }

  .proof { background: var(--ink); color: #fff; }
  .proof__row { list-style: none; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem 1.2rem; padding-top: 1.3rem; padding-bottom: 1.3rem; }
  .proof__row li { display: flex; flex-direction: column; line-height: 1.25; }
  .proof__row b { font-family: var(--font-head); font-weight: 900; color: #FF4D6D; font-size: 1.45rem; }
  .proof__row span { font-size: 0.85rem; font-weight: 700; color: #EDE6E2; }
  @media (min-width: 900px) {
    .proof__row { grid-template-columns: repeat(4, 1fr); }
    .proof__row li { flex-direction: row; align-items: baseline; gap: 0.6rem; }
    .proof__row b { font-size: 1.7rem; }
  }

  /* 1b · shop by moment */
  .moments__h { color: var(--ink-soft); }
  .moments__h em { color: var(--red-text); }
  .moments__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 12px; }
  @media (min-width: 900px) { .moments__grid { grid-template-columns: repeat(3, 1fr); gap: 22px 20px; } }
  .mtile { display: flex; flex-direction: column; gap: 0.55rem; }
  .mtile__img { aspect-ratio: 16 / 11; border-radius: 14px; overflow: hidden; display: grid; place-items: center; padding: 8%; transition: transform .2s; }
  .mtile:hover .mtile__img { transform: translateY(-3px); }
  .mtile__img img { height: 100%; width: auto; object-fit: contain; border-radius: 6px; box-shadow: 0 8px 18px -10px rgba(22,18,15,.35); }
  .mtile__img--cut img { box-shadow: none; filter: drop-shadow(0 10px 10px rgba(0,0,0,.22)); }
  .mtile__img--all { background: var(--ink); color: #fff; place-items: start; align-content: center; gap: 0.4rem; padding: 0 10%; font-family: var(--font-head); font-weight: 900; text-transform: uppercase; font-size: clamp(1.1rem, 3.6vw, 1.8rem); line-height: 1; }
  .mtile__label { font-family: var(--font-head); font-weight: 800; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.04em; }

  /* 2 · what we make */
  .make { background: #FAE3E0; }
  .make__h { font-size: clamp(2.2rem, 7vw, 3.4rem); }
  .make__row {
    display: grid; grid-auto-flow: column; grid-auto-columns: 74%; gap: 14px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 20px; padding: 4px 20px 12px; margin: 0 -20px;
    scrollbar-width: none;
  }
  .make__row::-webkit-scrollbar { display: none; }
  @media (min-width: 700px) { .make__row { grid-auto-columns: 42%; margin: 0 -32px; padding: 4px 32px 12px; } }
  @media (min-width: 1000px) { .make__row { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; margin: 0; padding: 0; } }
  .mcard {
    scroll-snap-align: start; background: #fff; border-radius: 20px; padding: 16px;
    display: flex; flex-direction: column; gap: 0.8rem; min-height: 330px; transition: transform .2s, box-shadow .2s;
  }
  .mcard:hover { transform: translateY(-4px); box-shadow: var(--shadow-soft); }
  .mcard .pill { align-self: flex-start; }
  .pill--white { background: #fff; color: var(--ink); }
  .mcard__img { width: 78%; margin: 0 auto; border-radius: 6px; box-shadow: 0 10px 22px -14px rgba(22,18,15,.45); }
  .mcard__name { font-family: var(--font-head); font-weight: 900; text-transform: uppercase; font-size: 1rem; margin-top: auto; }
  .mcard__foot { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-head); font-weight: 800; font-size: 0.95rem; }
  .mcard--soon { background: var(--ink); color: #fff; }
  .mcard__soon { font-size: clamp(1.6rem, 6vw, 1.9rem); margin-top: auto; color: #fff; }
  .mcard__wait { color: #FF8FA6; }

  /* 3 · BluBabyShow */
  .show__panel {
    background: var(--sky); color: var(--navy); border-radius: 24px; overflow: hidden;
    display: grid; gap: 0.5rem; padding: 24px 20px 28px;
  }
  .show__art { width: 62%; max-width: 280px; margin: 0 auto; filter: drop-shadow(0 16px 14px rgba(15,46,74,.22)); }
  .show__eye { color: var(--navy); }
  .show__h { color: var(--navy); font-size: clamp(2.2rem, 7vw, 3.2rem); letter-spacing: -0.03em; }
  .show__lead { font-weight: 800; font-size: 1.05rem; }
  .show__cta { display: flex; flex-wrap: wrap; gap: 10px; margin: 1.2rem 0 1rem; }
  .show__btn { background: var(--navy); color: #fff; flex: 1 1 200px; }
  .show__btn:hover { background: #0A1F33; }
  .show__btn--ghost { background: transparent; color: var(--navy); border-color: var(--navy); }
  .show__btn--ghost:hover { background: #fff; }
  .show__more { display: inline-flex; align-items: center; gap: 6px; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 860px) {
    .show__panel { grid-template-columns: 0.8fr 1.2fr; align-items: center; padding: 32px 48px; }
    .show__art { width: 100%; }
    .show__btn { flex: 0 0 auto; }
  }

  /* 4 · how it works */
  .how {
    background-color: #FBFAFF;
    background-image: linear-gradient(#E8E6F4 1px, transparent 1px), linear-gradient(90deg, #E8E6F4 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .how__h { text-align: center; text-transform: uppercase; font-weight: 800; font-size: clamp(1.5rem, 4.4vw, 2.2rem); margin-bottom: 1.6rem; }
  .how__row { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  @media (min-width: 800px) { .how__row { grid-template-columns: repeat(3, 1fr); } }
  .how__step { background: #fff; border: 2px solid var(--red); padding: 18px 20px 14px; }
  .how__n { display: block; font-family: var(--font-head); font-stretch: 75%; font-weight: 900; font-size: 2.6rem; line-height: 1; color: var(--red-text); margin-bottom: 0.5rem; }
  .how__step h3 { text-transform: uppercase; font-size: 1rem; margin-bottom: 0.4rem; }
  .how__step p { font-size: 0.95rem; margin: 0; color: #3A3330; }

  /* 5b · slogan */
  .slogan { background: var(--yellow); }
  .slogan__row { display: flex; align-items: center; gap: 14px; padding-top: 1.1rem; padding-bottom: 1.1rem; }
  .slogan svg { width: 54px; flex: none; }
  .slogan p { margin: 0; font-size: clamp(1.5rem, 4vw, 2.1rem); line-height: 1.1; }

  /* 6 · moments wall */
  .wallsec { background: #FFFCF6; }
  .wallsec__h { color: #C1122F; font-size: clamp(2.2rem, 6vw, 3rem); margin-bottom: 0.2em; }
  .wall { columns: 2; column-gap: 12px; }
  @media (min-width: 900px) { .wall { columns: 4; column-gap: 16px; } }
  .wt {
    break-inside: avoid; display: flex; flex-direction: column; justify-content: flex-end; position: relative;
    height: calc(var(--h) * 0.72); margin-bottom: 12px; border-radius: 16px; overflow: hidden;
    transition: transform .2s;
  }
  @media (min-width: 900px) { .wt { height: var(--h); margin-bottom: 16px; } }
  .wt:hover { transform: translateY(-3px); }
  .wt img { position: absolute; inset: 8px 8px 52px; width: calc(100% - 16px); height: calc(100% - 60px); object-fit: contain; }
  .wt__label { position: relative; padding: 0 12px 10px; display: flex; flex-direction: column; line-height: 1.2; }
  .wt__label b { font-family: var(--font-head); font-weight: 800; font-size: 0.92rem; }
  .wt__label small { font-size: 0.78rem; color: #4A423E; font-weight: 700; }
  .wt--link { align-items: center; justify-content: center; text-align: center; color: #fff; gap: 0.3rem; }
  .wt__small { font-family: var(--font-head); font-weight: 800; font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .wt__big { font-size: clamp(1.3rem, 4.4vw, 1.7rem); }
  .wt__btn { width: 40px; height: 40px; border-radius: 50%; background: #fff; color: var(--red); display: grid; place-items: center; margin-top: 0.4rem; }
  .wt__btn--red { background: var(--red); color: #fff; }

  /* 7 · watch / play / shop */
  .wps { padding-top: 0; background: #FFFCF6; }
  .wps__row { display: grid; gap: 14px; }
  @media (min-width: 800px) { .wps__row { grid-template-columns: repeat(3, 1fr); } }
  .wcard {
    position: relative; height: 260px; border-radius: 26px; overflow: hidden; display: flex; align-items: flex-end;
    box-shadow: 0 16px 40px rgba(0,0,0,0.10); transition: transform .2s;
  }
  @media (min-width: 800px) { .wcard { height: 400px; } }
  .wcard:hover { transform: translateY(-4px); }
  .wcard__cut { position: absolute; top: 18px; left: 50%; transform: translateX(-50%); height: 72%; width: auto; filter: drop-shadow(0 12px 12px rgba(0,0,0,.18)); }
  .wcard__cover { position: absolute; top: 22px; left: 50%; transform: translateX(-50%) rotate(4deg); height: 64%; width: auto; border-radius: 6px; box-shadow: 0 14px 24px rgba(0,0,0,.25); }
  .wcard__t { position: relative; padding: 0 0 20px 24px; color: #fff; font-size: 2.2rem; text-shadow: 0 2px 10px rgba(0,0,0,0.25); }
  @media (max-width: 799px) {
    .wcard { height: 200px; }
    .wcard__cut, .wcard__cover { left: auto; right: 18px; transform: none; height: 82%; top: 9%; }
    .wcard__cover { transform: rotate(4deg); height: 74%; top: 12%; }
  }
</style>
