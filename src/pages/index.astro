---
import Base from '../layouts/Base.astro';
import Doodles from '../components/Doodles.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';

const latestPosts = (await getPublishedPosts()).slice(0, 3);

/* ------------------------------------------------------------------
   PHASE 0 — "Blu's Sunny World" homepage.
   Bluey-warm × Cocomelon-catchy. Character-first, bright, joyful.
   Doubles as the link-in-bio destination: convert the 165K/mo IG
   profile-visit click into an owned email or a revenue action.
   Swap the placeholder character PNGs (same filenames) as better
   art is generated. TODO(studio): read published content from Supabase.
------------------------------------------------------------------ */

const pillars = [
  { title: 'Big Feelings', blurb: 'Little moments about the feelings of growing up, and of raising a tiny human.', c: 'var(--orange)', img: '/episodes/kisses-sister.webp' },
  { title: 'Calm & Bedtime', blurb: 'Slow, wordless calm reels and swipe-through storybooks for winding down.', c: 'var(--grass)', img: '/episodes/meets-baby-sister.webp' },
  { title: 'Blu vs the World', blurb: 'Tiny-chaos comedy. Flour, toothpaste, and one very patient Dad.', c: 'var(--sun)', img: '/episodes/toothpaste-mohawk.webp' },
  { title: 'Family Life', blurb: 'Warm slice-of-life with Mum, Dad, Puppy and baby Sister.', c: 'var(--grape)', img: '/episodes/belly-hug.webp' },
];

/* Real numbers (Instagram Graph API, 14 Nov 2026). Update when they move. */
const proof = { views: '92M+', followers: '64K+', likes: '1.9M+', comments: '6,900+' };

/* Most-watched episodes: real reels, real view counts. */
const episodes = [
  { img: '/episodes/big-brother-hospital.webp', title: 'The day he became a big brother', views: '18.2M', href: 'https://www.instagram.com/reel/DZFNhZQy_xV/' },
  { img: '/episodes/meets-baby-sister.webp', title: 'Blu meets his baby sister', views: '12.2M', href: 'https://www.instagram.com/reel/DY2YIe_ydwo/' },
  { img: '/episodes/flour-ghosts.webp', title: 'Dad was baking. Blu had one job.', views: '12.0M', href: 'https://www.instagram.com/reel/DYeepWIMZ5R/' },
  { img: '/episodes/picks-his-outfit.webp', title: 'Blu picks his own outfit', views: '5.9M', href: 'https://www.instagram.com/reel/DZKLj_9SUPx/' },
  { img: '/episodes/tummy-grumble.webp', title: 'His tummy grumbled…', views: '4.5M', href: 'https://www.instagram.com/reel/DY1w-mYs2Ko/' },
  { img: '/episodes/toothpaste-mohawk.webp', title: 'Dad turned around for one second', views: '2.0M', href: 'https://www.instagram.com/reel/DYuwBGZyg0S/' },
];

/* Real comments from our Instagram reels, copied verbatim (scratch pull 14 Nov 2026). Only the first letter of each real handle is shown. */
const comments = [
  { text: 'Mera baby bhi same esa hi karta h 😍❤️', tr: 'My baby does exactly the same!', who: 'a•••••', lang: 'Hindi' },
  { text: "Sometimes it's our little kid who gives us assurance ..that adults can't give...", who: 's•••••', lang: '' },
  { text: 'Que família linda! Amei demais', tr: 'What a lovely family! Loved it so much', who: 'l•••••', lang: 'Portuguese' },
  { text: 'that moment we realize we need them more than they need us. 😢', who: 'a•••••', lang: '' },
  { text: 'Hermosa que lindo le su besito a su hermanita', tr: 'So sweet, his little kiss for his baby sister', who: 'e•••••', lang: 'Spanish' },
  { text: 'I need to show this to my toddler', who: 'l•••••', lang: '' },
  { text: 'Dunia perbayian sungguh imutt', tr: 'The baby world is so adorable', who: 'i•••••', lang: 'Indonesian' },
  { text: 'One of the best moments in a family❤️❤️', who: 'y•••••', lang: '' },
  { text: 'Las madres cargan con muchas cosas pero siguen adelante', tr: 'Mothers carry so much, and still keep going', who: 'e•••••', lang: 'Spanish' },
];

const hub = [
  { label: 'Watch the newest episode', sub: 'A new episode every day', href: 'https://www.instagram.com/theblubabyshow/', c: 'var(--blu)', icon: 'play' },
  { label: 'Join Blu’s Sunday Club', sub: 'Free feelings cards inside', href: '#newsletter', c: 'var(--sun)', icon: 'mail' },
  { label: 'Blu Kits', sub: 'Potty, new baby, kind hands, bedtime', href: '/kits/', c: 'var(--grape)', icon: 'book' },
  { label: 'The Blu Shop', sub: 'Printable PDFs for parents', href: '/shop/', c: 'var(--grass)', icon: 'pencil' },
  { label: 'Watch on the big screen', sub: 'Subscribe on YouTube', href: 'https://www.youtube.com/@blubabyshow', c: 'var(--sky)', icon: 'tv' },
];

const family = [
  { img: '/characters/blu_face.webp',    name: 'Blu',    tag: 'the little mischief', c: 'var(--blu)' },
  { img: '/characters/mom_face.webp',    name: 'Mum',    tag: 'keeps it all together', c: 'var(--pink)' },
  { img: '/characters/dad_face.webp',    name: 'Dad',    tag: 'always shows up', c: 'var(--sky)' },
  { img: '/characters/puppy.webp',       name: 'Puppy',  tag: 'clumsy & kind', c: 'var(--sun)', cutout: true },
  { img: '/characters/sister_face.webp', name: 'Sister', tag: 'the newest baby', c: 'var(--grape)' },
];
---

<Base>
  <!-- ============ HERO — welcome card over a full family scene (bluey.tv style) ============ -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__card reveal d1">
        <p class="eyebrow">Welcome to the home of Blu</p>
        <h1>The happiest<br /><span class="hero__pop">little show</span><br />for real families.</h1>
        <p class="hero__sub">
          Warm, giggly little stories that help your little one name big feelings —
          and make the long days a little softer. Watched <strong>{proof.views.replace('M+', ' million+')}</strong> times
          by families around the world.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="https://www.instagram.com/theblubabyshow/">Watch Blu on Instagram</a>
          <a class="btn btn--sun" href="#newsletter">Get the free Feelings Cards</a>
        </div>
        <div class="hero__stats">
          <span><b>{proof.views}</b> views</span>
          <span class="dotsep">·</span>
          <span><b>{proof.followers}</b> followers</span>
          <span class="dotsep">·</span>
          <span><b>{proof.likes}</b> likes</span>
        </div>
      </div>
    </div>

    <!-- Real stills from our most-watched reels (not mock-ups) -->
    <div class="hero__reels" aria-label="Stills from Blu's most-watched episodes">
      {episodes.slice(0, 5).map((e, i) => (
        <a class={`reel reel--${i}`} href={e.href} target="_blank" rel="noopener">
          <img src={e.img} alt={e.title} width="720" height="900" fetchpriority={i === 2 ? 'high' : 'auto'} loading={i === 2 ? 'eager' : 'lazy'} decoding="async" />
          <span class="reel__views">▶ {e.views}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ STATS MARQUEE ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {Array.from({ length: 2 }).map(() => (
        <span class="marquee__row">
          <b>{proof.views} views</b> ★ <b>{proof.followers} followers</b> ★ <b>{proof.likes} likes</b> ★
          <b>{proof.comments} comments</b> ★ <b>feelings before facts</b> ★
        </span>
      ))}
    </div>
  </div>

  <!-- ============ SOCIAL PROOF: most-watched + real comments ============ -->
  <section class="section proof" id="watch">
    <div class="wrap">
      <div class="section__head section--center">
        <p class="eyebrow">Loved by real families</p>
        <h2>Our most-watched episodes</h2>
        <p class="muted">Real view counts from Instagram. Tap any one to watch it.</p>
      </div>
      <div class="eps">
        {episodes.map((e) => (
          <a class="ep" href={e.href} target="_blank" rel="noopener">
            <span class="ep__ph">
              <img src={e.img} alt={e.title} width="720" height="900" loading="lazy" decoding="async" />
              <span class="ep__play" aria-hidden="true">▶</span>
            </span>
            <span class="ep__t">{e.title}</span>
            <span class="ep__v"><b>{e.views}</b> views</span>
          </a>
        ))}
      </div>

      <div class="section__head section--center saying">
        <h2>What parents are saying</h2>
        <p class="muted">Real comments from our Instagram, in many languages. We hide names to protect people’s privacy.</p>
      </div>
      <div class="cmts">
        {comments.map((c) => (
          <figure class="cmt">
            <div class="cmt__top">
              <span class="cmt__av" aria-hidden="true">{c.who[0].toUpperCase()}</span>
              <span class="cmt__who">{c.who}{c.lang && <span class="cmt__lang"> · {c.lang}</span>}</span>
              <span class="cmt__ig" aria-label="Instagram comment">Instagram</span>
            </div>
            <blockquote>{c.text}</blockquote>
            {c.tr && <figcaption>“{c.tr}”</figcaption>}
          </figure>
        ))}
      </div>
      <div class="proof__cta">
        <a class="btn btn--primary" href="https://www.instagram.com/theblubabyshow/" target="_blank" rel="noopener">See all on @theblubabyshow</a>
      </div>
    </div>
  </section>

  <!-- ============ LINK HUB ============ -->
  <section class="section hub-sec">
    <div class="wrap">
      <div class="section__head section--center">
        <p class="eyebrow">Start here</p>
        <h2>Where do you want to go?</h2>
      </div>
      <div class="hub">
        {hub.map((l, i) => (
          <a class={`hub__card tilt${i % 2}`} href={l.href} style={`--c:${l.c}`}>
            <span class="hub__ic"><Icon name={l.icon} size={22} /></span>
            <span class="hub__t">
              <span class="hub__label">{l.label}</span>
              <span class="hub__sub">{l.sub}</span>
            </span>
            <span class="hub__arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ NEWSLETTER (primary conversion) ============ -->
  <section class="section news" id="newsletter">
    <Doodles variant="sparse" />
    <div class="wrap news__card">
      <div class="news__copy">
        <p class="eyebrow eyebrow--light"><Icon name="mail" size={16} /> Blu’s Sunday Club</p>
        <h2>One warm story + one new Blu video.<br />Every Sunday. Free.</h2>
        <p class="news__lead">
          You’re doing better than you think. Every Sunday we’ll send one gentle story and
          one new Blu video — plus the <strong>free Blu Feelings Cards</strong> to help your
          little one say what they feel.
        </p>
        <form class="news__form" id="newsForm" novalidate>
          <input class="news__input" type="email" name="email" placeholder="your@email.com" aria-label="Email address" required />
          <input type="text" name="hp" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn btn--sun" type="submit">Send me Sunday moments</button>
        </form>
        <p class="news__msg" id="newsMsg" role="status" aria-live="polite"></p>
        <p class="news__fine">No spam, ever · one email a week · unsubscribe anytime</p>
      </div>
      <div class="news__art" aria-hidden="true">
        <img loading="lazy" decoding="async" src="/episodes/belly-hug.webp" alt="" width="720" height="900" />
        <span class="news__stamp">FREE<br />printable</span>
      </div>
    </div>
  </section>

  <!-- ============ PILLARS ============ -->
  <section class="section section--center" id="kinds">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow">What we make</p>
        <h2>Four kinds of Blu</h2>
        <p class="muted">Feelings, laughs, family and calm. No words needed. A new little episode every day.</p>
      </div>
      <div class="pillars">
        {pillars.map((p, i) => (
          <a class={`pill tilt${i % 2}`} href="https://www.instagram.com/theblubabyshow/" style={`--c:${p.c}`}>
            <span class="pill__img"><img src={p.img} alt="" width="720" height="900" loading="lazy" decoding="async" /></span>
            <h3>{p.title}</h3>
            <p class="muted">{p.blurb}</p>
            <span class="pill__go">See more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ MEET THE FAMILY ============ -->
  <section class="section fam" id="story">
    <div class="wrap">
      <div class="section__head section--center">
        <p class="eyebrow" style="color:#fff">The whole gang</p>
        <h2 style="color:#fff">Meet Blu’s family</h2>
      </div>
      <div class="fam__row">
        {family.map((m) => (
          <div class="fam__card" style={`--c:${m.c}`}>
            <div class={`fam__ph${m.cutout ? ' fam__ph--cut' : ''}`}><img loading="lazy" decoding="async" src={m.img} alt={m.name} width="400" height="400" /></div>
            <strong>{m.name}</strong>
            <span>{m.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ LEARN ============ -->
  <section class="section learn" id="kits">
    <div class="wrap learn__grid">
      <div class="learn__art">
        <span class="learn__blob" aria-hidden="true"></span>
        <img loading="lazy" decoding="async" class="sticker" src="/characters/puppy.webp" alt="Blu’s puppy" width="340" height="340" />
      </div>
      <div class="learn__copy">
        <p class="eyebrow">Blu Kits</p>
        <h2>Help for the big toddler moments.</h2>
        <p class="muted">
          Potty training, a new baby, hitting, bedtime. Each kit is a Blu video, a short
          story and the exact words to say. Made for your phone.
        </p>
        <a class="btn btn--grass" href="/kits/">See the Blu Kits →</a>
      </div>
    </div>
  </section>

  <!-- ============ MUSIC ============ -->
  <section class="section music" id="music">
    <div class="wrap music__grid">
      <div class="music__copy">
        <p class="eyebrow">Blu’s Bedtime</p>
        <h2>Lullabies for winding down.</h2>
        <p class="muted">
          Soft, wordless bedtime music from Blu’s calm reels. Press play at 2 a.m.
          and let Blu do the winding down.
        </p>
        <div class="music__links">
          <span class="btn btn--ghost btn--soon" role="link" aria-disabled="true">Spotify</span>
          <span class="btn btn--ghost btn--soon" role="link" aria-disabled="true">Apple Music</span>
          <span class="btn btn--ghost btn--soon" role="link" aria-disabled="true">YouTube Music</span>
        </div>
      </div>
      <!-- TODO: replace with real Spotify embed once distributed via DistroKid -->
      <div class="player">
        <div class="player__disc"><span></span></div>
        <div class="player__wave">
          {Array.from({ length: 9 }).map(() => <span></span>)}
        </div>
        <p>Blu’s Bedtime: Vol. 1 · coming this season</p>
      </div>
    </div>
  </section>

  <!-- ============ SHOP ============ -->
  <section class="section shop" id="shop">
    <div class="wrap shop__grid">
      <div class="shop__cover">
        <span class="shop__ribbon">PDF</span>
        <img loading="lazy" decoding="async" class="sticker" src="/characters/blu_book.webp" alt="Blu holding the Blu Colouring Book" width="300" height="300" />
      </div>
      <div class="shop__copy">
        <p class="eyebrow">The Blu Shop</p>
        <h2>The Blu Colouring Book</h2>
        <p class="muted">
          20 pages of Blu’s world to colour in: feelings, family and tiny adventures.
          A digital download (PDF soft copy) you print at home. Nothing is shipped.
        </p>
        <p class="shop__price"><span class="shop__amt" data-price-inr="149" data-price-usd="7">₹149</span> <span>· instant PDF download</span></p>
        <a class="btn btn--primary" href="/shop/">Visit the Blu Shop</a>
      </div>
    </div>
  </section>

  <!-- ============ FROM THE BLOG (renders nothing if no published posts) ============ -->
  {latestPosts.length > 0 && (
    <section class="section blogteaser">
      <div class="wrap">
        <div class="blogteaser__head">
          <p class="eyebrow">Small Moments</p>
          <h2>From the blog</h2>
          <p class="muted">Gentle, practical notes for parents of little ones.</p>
        </div>
        <div class="blogteaser__grid">{latestPosts.map((p) => <PostCard post={p} />)}</div>
        <div class="blogteaser__more"><a class="btn btn--primary" href="/blog/">Read the blog</a></div>
      </div>
    </section>
  )}

  <!-- ============ CLOSING CTA ============ -->
  <section class="section closing section--center">
    <Doodles variant="hero" />
    <div class="wrap">
      <div class="closing__cast" aria-hidden="true">
        <span class="cast cast--mom"><img loading="lazy" decoding="async" src="/characters/mom_face.webp" alt="" width="400" height="400" /></span>
        <span class="cast cast--dad"><img loading="lazy" decoding="async" src="/characters/dad_face.webp" alt="" width="400" height="400" /></span>
        <span class="cast cast--blu"><img loading="lazy" decoding="async" src="/characters/blu_face.webp" alt="" width="400" height="400" /></span>
        <span class="cast cast--sister"><img loading="lazy" decoding="async" src="/characters/sister_face.webp" alt="" width="400" height="400" /></span>
        <span class="cast cast--puppy"><img loading="lazy" decoding="async" src="/characters/puppy.webp" alt="" width="400" height="400" /></span>
      </div>
      <h2>Come hang out with Blu every day.</h2>
      <p class="muted closing__sub">Free, warm, and made with love. A new little episode every day.</p>
      <div class="closing__cta">
        <a class="btn btn--primary" href="https://www.instagram.com/theblubabyshow/">Follow on Instagram</a>
        <a class="btn btn--sun" href="#newsletter">Join Blu’s Sunday Club</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Local currency for static prices (same rule as the shop: India time zone = ₹, else $).
  const inIndia = (() => { try { return /Asia\/(Kolkata|Calcutta)/.test(Intl.DateTimeFormat().resolvedOptions().timeZone); } catch { return true; } })();
  document.querySelectorAll('[data-price-inr]').forEach((el) => {
    el.textContent = inIndia ? `₹${el.dataset.priceInr}` : `$${el.dataset.priceUsd}`;
  });

  const form = document.getElementById('newsForm');
  const msg = document.getElementById('newsMsg');
  if (form && msg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[type=email]');
      const btn = form.querySelector('button');
      const email = (input?.value || '').trim();
      const hp = form.querySelector('input[name=hp]')?.value || '';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.textContent = 'Please enter a valid email 💛';
        msg.className = 'news__msg news__msg--err';
        return;
      }
      const label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'website', hp }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.style.display = 'none';
          msg.innerHTML = "You're in! 💛 Welcome to Blu's Sunday Club. <a href='/free/blu-feelings-cards-A4.pdf' download>Download your free Feelings Cards (PDF)</a>";
          msg.className = 'news__msg news__msg--ok';
          // Conversion event (PostHog) — only fires on a real success. No-op if PH is off.
          window.posthog?.capture?.('newsletter_signup', { source: 'website' });
          if (typeof window.fbq === 'function') window.fbq('track', 'Lead', { content_name: 'newsletter' });
        } else {
          msg.textContent = data.error || 'Something went wrong — please try again.';
          msg.className = 'news__msg news__msg--err';
          btn.disabled = false; btn.textContent = label;
        }
      } catch {
        msg.textContent = 'Network hiccup — please try again.';
        msg.className = 'news__msg news__msg--err';
        btn.disabled = false; btn.textContent = label;
      }
    });
  }
</script>

<style>
  /* ---- From the blog teaser ---- */
  .blogteaser__head { text-align: center; max-width: 620px; margin: 0 auto 2.4rem; }
  .blogteaser__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 1.5rem; }
  .blogteaser__more { text-align: center; margin-top: 2.4rem; }
  /* ---------- HERO — welcome card over family scene ---------- */
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--nav-h));
    padding-top: calc(var(--nav-h) + clamp(0.6rem, 2vw, 1.4rem));
    background: linear-gradient(180deg, #8ecbfb 0%, #6fbdf2 55%, #53ace4 100%);
    overflow: hidden;
  }
  .hero__card {
    position: relative; z-index: 2;
    max-width: 620px; margin: 0 auto;
    background: #fff; border-radius: var(--radius);
    padding: clamp(1.7rem, 4vw, 2.9rem) clamp(1.5rem, 4vw, 3rem);
    text-align: center;
    box-shadow: var(--shadow);
    border: 4px solid #fff;
  }
  .hero__card .eyebrow { justify-content: center; }
  .hero__card h1 { font-size: clamp(2.05rem, 5.6vw, 3.35rem); line-height: 1.04; margin-bottom: 0.5rem; }
  .hero__pop {
    color: var(--orange); position: relative; display: inline-block;
  }
  .hero__pop::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 4px; height: 12px;
    background: var(--sun); border-radius: 8px; z-index: -1; transform: rotate(-1deg);
  }
  .hero__sub { font-size: 1.12rem; max-width: 46ch; margin: 0.5rem auto 0; color: var(--ink-soft); }
  .hero__cta { display: flex; gap: 0.8rem; flex-wrap: wrap; justify-content: center; margin: 1.6rem 0 1.3rem; }
  .hero__stats { display: flex; align-items: center; justify-content: center; gap: 0.8rem; color: var(--ink-soft); font-size: 0.96rem; }
  .hero__stats b { font-family: var(--font-head); color: var(--blu-deep); }
  .dotsep { color: var(--sky-d); }

  /* Real reel stills fanned out under the welcome card */
  .hero__reels {
    position: relative; z-index: 1;
    display: flex; justify-content: center; align-items: flex-end;
    gap: clamp(0.4rem, 1.4vw, 1rem);
    margin: -1.2rem auto 0; padding: 0 1rem clamp(2rem, 4vw, 3rem);
    max-width: 1100px;
  }
  .reel {
    position: relative; display: block; flex: 0 0 auto;
    width: clamp(120px, 17vw, 200px); aspect-ratio: 4 / 5;
    border-radius: 22px; overflow: hidden; border: 5px solid #fff;
    box-shadow: 0 18px 34px rgba(30, 50, 90, 0.28);
    transition: transform 0.2s cubic-bezier(.34,1.56,.64,1);
  }
  .reel img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .reel--0 { transform: rotate(-7deg) translateY(28px); }
  .reel--1 { transform: rotate(-3deg) translateY(10px); }
  .reel--2 { width: clamp(150px, 21vw, 250px); z-index: 2; }
  .reel--3 { transform: rotate(3deg) translateY(10px); }
  .reel--4 { transform: rotate(7deg) translateY(28px); }
