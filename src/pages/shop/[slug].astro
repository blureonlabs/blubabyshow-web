---
// Product page (PDP), rebuilt 17 Nov 2026 in the pattern of strong kids/family DTC stores
// (see docs/PDP_STUDY.md): swipe gallery, facts chips, one clear buy button, trust row,
// sticky buy bar on phones, benefits, look inside, accordions, honest reviews slot, FAQ,
// refund promise, related products. Checkout stays on Dodo Payments via BuyButton.
// No invented reviews, ratings or sales counts: the reviews slot is empty and labelled.
import Base from '../../layouts/Base.astro';
import BuyButton from '../../components/BuyButton.astro';
import StayOffer from '../../components/StayOffer.astro';
import Icon from '../../components/Icon.astro';
import { products, bySlug } from '../../data/products';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const p = bySlug(Astro.params.slug!)!;
const related = products.filter((x) => x.slug !== p.slug);
const gallery = [p.img, ...(p.previews ?? [])];
const shortName = p.name.replace(' (PDF)', '');
const live = Boolean(p.checkoutInr || p.checkoutUsd);

const facts = [p.ages, `${p.pages} pages`, 'PDF', 'A4 + US Letter'];
const benefits = [
  { icon: 'download', t: 'Instant download', d: 'Ready the moment you pay. Nothing to wait for.' },
  { icon: 'printer', t: 'Print at home', d: 'Print as many copies as your own family needs.' },
  { icon: 'phone', t: 'Works on a phone', d: 'Read it on any phone, tablet or computer.' },
  { icon: 'globe', t: 'Pay your way', d: 'UPI, RuPay and cards in India. Cards everywhere else.' },
];
const faqs = [
  { q: 'Is this a printed book?', a: 'No. It is a digital soft copy (PDF). Nothing is posted to you; you download it and print at home or at any print shop.' },
  { q: 'How do I get it after paying?', a: 'You get a download link on screen straight after paying, and by email.' },
  { q: 'Can I pay with UPI?', a: 'Yes. In India you can pay with UPI, RuPay or any card. Outside India, all major cards work.' },
  { q: 'Can I print it more than once?', a: 'Yes, as often as your own family needs. Please don’t resell or share the file.' },
  { q: 'What if it isn’t right for us?', a: 'Email us within 7 days and we will refund you. See the refund policy for details.' },
];

const SITE = 'https://www.blubabyshow.com';
const url = `${SITE}/shop/${p.slug}/`;
const ogImage = `/og/${p.slug}.png`;
const jsonLd = [
  {
    '@type': 'Product',
    '@id': `${url}#product`,
    name: p.name,
    description: `${p.short} ${p.format}`,
    image: [`${SITE}${ogImage}`, `${SITE}${p.img}`],
    url,
    sku: p.slug,
    category: 'Digital printable (PDF)',
    brand: { '@type': 'Brand', name: 'Blululu' },
    offers: {
      '@type': 'Offer',
      url,
      price: p.inr.toFixed(2),
      priceCurrency: 'INR',
      // Checkout link set = buyable now; otherwise the page collects "notify me" sign-ups.
      availability: live ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
      itemCondition: 'https://schema.org/NewCondition',
      seller: { '@id': `${SITE}/#org` },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        applicableCountry: 'IN',
        returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
        merchantReturnDays: 7,
        returnFees: 'https://schema.org/FreeReturn',
      },
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Shop', item: `${SITE}/shop/` },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
];
---

<Base
  title={`${shortName} (PDF printable) · Blululu Shop`}
  description={`${p.short} Instant PDF download, ₹${p.inr}. Nothing is shipped. Pay with UPI or card.`}
  image={ogImage}
  imageAlt={`${p.name}, a printable PDF from Blululu`}
  type="product"
  jsonLd={jsonLd}
>
  <nav class="crumbs wrap" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><a href="/shop/">Shop</a><span aria-hidden="true">/</span><span aria-current="page">{shortName}</span>
  </nav>

  <section class="pdp wrap">
    <!-- Gallery: swipe on phones, thumbnails below -->
    <div class="gal">
      <div class="gal__track" id="galTrack">
        {gallery.map((src, i) => (
          <figure class="gal__slide" id={`g${i}`}>
            <img src={src} alt={i === 0 ? p.imgAlt : `Inside page ${i} of ${shortName}`} width="800" height="800" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
          </figure>
        ))}
      </div>
      <div class="gal__thumbs" role="list">
        {gallery.map((src, i) => (
          <a role="listitem" class="gal__thumb" href={`#g${i}`} data-i={i} aria-label={`Show image ${i + 1}`}>
            <img src={src} alt="" width="120" height="120" loading="lazy" />
          </a>
        ))}
      </div>
    </div>

    <!-- Buy box -->
    <div class="box">
      <div class="box__badges">
        <span class="badge">Blululu Original</span>
        <span class="badge badge--show">from BluBabyShow</span>
      </div>
      <h1 class="box__h">{shortName}</h1>
      <!-- REVIEWS SLOT: stays empty until we have real reviews. Never fill with made-up stars. -->
      <p class="box__rev">No reviews yet · <a href="/contact/">bought it? tell us</a></p>
      <p class="box__short">{p.short}</p>
      <ul class="facts">{facts.map((f) => <li>{f}</li>)}</ul>
      <p class="box__price">
        <span data-price-inr={p.inr} data-price-usd={p.usd}>₹{p.inr}</span>
        <small>one-time · digital download</small>
      </p>
      <div id="mainBuy"><BuyButton product={p} full /></div>
      <ul class="trust">
        <li><Icon name="download" size={18} />Instant PDF download</li>
        <li><Icon name="refresh" size={18} />7-day refund</li>
        <li><Icon name="lock" size={18} />Secure checkout</li>
      </ul>
      <p class="box__ship"><Icon name="file" size={18} />Digital download only. Nothing is shipped; you print it at home.</p>

      <div class="acc">
        <details open>
          <summary>What’s inside<Icon name="plus" size={18} /></summary>
          <ul class="ticks">{p.inside.map((i) => <li><Icon name="check" size={16} />{i}</li>)}</ul>
        </details>
        <details>
          <summary>Who it’s for<Icon name="plus" size={18} /></summary>
          <p>{p.forWho}</p>
        </details>
        <details>
          <summary>Format and printing<Icon name="plus" size={18} /></summary>
          <p>{p.format}</p>
        </details>
        <details>
          <summary>Refunds<Icon name="plus" size={18} /></summary>
          <p>Not right for your family? Email us within 7 days and we will refund you. <a href="/refund/">Refund policy</a>.</p>
        </details>
      </div>
      {p.slug === 'meltdown-scripts' && (
        <p class="note">A friendly guide, not medical advice. Every child is different; for anything that worries you, talk to your paediatrician.</p>
      )}
    </div>
  </section>

  <!-- Benefits row -->
  <section class="ben">
    <ul class="wrap ben__row">
      {benefits.map((b) => (
        <li><span class="ben__ic"><Icon name={b.icon} size={22} /></span><b>{b.t}</b><span>{b.d}</span></li>
      ))}
    </ul>
  </section>

  <!-- Look inside -->
  {p.previews && (
    <section class="section look">
      <div class="wrap">
        <h2 class="display">Look <em>inside</em></h2>
        <div class="look__row">
          {p.previews.map((src, i) => <img src={src} alt={`Page preview ${i + 1} of ${shortName}`} loading="lazy" width="636" height="900" />)}
        </div>
      </div>
    </section>
  )}

  <!-- How it works -->
  <section class="section how">
    <div class="wrap">
      <h2 class="how__h">How it works</h2>
      <ol class="how__row">
        <li class="how__step"><span class="how__n">01</span><h3>Pay once</h3><p>UPI, RuPay or card. Your price shows in your own currency.</p></li>
        <li class="how__step"><span class="how__n">02</span><h3>Download</h3><p>The PDF is ready straight away, on screen and by email.</p></li>
        <li class="how__step"><span class="how__n">03</span><h3>Print and play</h3><p>Print at home or at any print shop, as often as you need.</p></li>
      </ol>
    </div>
  </section>

  <!-- Reviews: honest empty slot -->
  <section class="section revs">
    <div class="wrap">
      <h2 class="display">Parent <em>reviews</em></h2>
      <div class="revs__empty">
        <p><b>No reviews yet.</b> This is a new Blululu Original, and we only show reviews from real buyers.</p>
        <p>Used it at home? We would love to hear how it went. <a href="/contact/">Send us a note</a>.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq">
    <div class="wrap narrow">
      <h2 class="display">Questions</h2>
      <div class="acc">
        {faqs.map((f) => (
          <details><summary>{f.q}<Icon name="plus" size={18} /></summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <!-- Promise -->
  <section class="promise">
    <div class="wrap promise__row">
      <span class="promise__ic"><Icon name="shield" size={28} /></span>
      <div>
        <h2 class="promise__h">The 7-day promise</h2>
        <p>If it isn’t right for your family, email us within 7 days for a full refund. No forms, no fuss.</p>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="section rel">
    <div class="wrap">
      <h2 class="display">You might <em>also like</em></h2>
      <div class="rel__row">
        {related.map((r) => (
          <a class="rel__card" href={`/shop/${r.slug}/`}>
            <img src={r.img} alt={r.imgAlt} width="800" height="800" loading="lazy" />
            <span class="rel__name">{r.name.replace(' (PDF)', '')}</span>
            <span class="rel__price" data-price-inr={r.inr} data-price-usd={r.usd}>₹{r.inr}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Sticky buy bar (phones), shows once the main button scrolls away -->
  <div class="sbar" id="sbar" aria-hidden="true">
    <div class="sbar__in">
      <img src={p.img} alt="" width="44" height="44" />
      <div class="sbar__t"><b>{shortName}</b><span data-price-inr={p.inr} data-price-usd={p.usd}>₹{p.inr}</span></div>
      <BuyButton product={p} />
    </div>
  </div>

  <StayOffer product={p} />
</Base>

<script define:vars={{ slug: p.slug, inr: p.inr }}>
  if (typeof window.fbq === 'function') {
    window.fbq('track', 'ViewContent', { content_ids: [slug], content_type: 'product', value: inr, currency: 'INR' });
  }
</script>

<script>
  // Gallery: thumbnails scroll the track; the active thumb follows the swipe.
  const track = document.getElementById('galTrack');
  const thumbs = [...document.querySelectorAll<HTMLAnchorElement>('.gal__thumb')];
  if (track) {
    thumbs.forEach((t) => t.addEventListener('click', (e) => {
      e.preventDefault();
      track.scrollTo({ left: Number(t.dataset.i) * track.clientWidth, behavior: 'smooth' });
    }));
    const mark = () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      thumbs.forEach((t, k) => t.classList.toggle('is-on', k === i));
    };
    track.addEventListener('scroll', mark, { passive: true }); mark();
  }
  // Sticky bar: visible only while the main buy button is off screen.
  const main = document.getElementById('mainBuy');
  const bar = document.getElementById('sbar');
  if (main && bar && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      const show = !e.isIntersecting && e.boundingClientRect.top < 0;
      bar.classList.toggle('is-on', show);
      bar.setAttribute('aria-hidden', String(!show));
    }).observe(main);
  }
</script>

<style>
  .crumbs { display: flex; gap: 6px; flex-wrap: wrap; font-size: 0.8rem; color: var(--ink-soft); padding-top: 14px; padding-bottom: 10px; }
  .crumbs a { text-decoration: underline; text-underline-offset: 2px; }
  .crumbs [aria-current] { color: var(--ink); font-weight: 700; }

  .pdp { display: grid; gap: 1.4rem; padding-bottom: 2rem; }
  @media (min-width: 900px) { .pdp { grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: start; } .gal { position: sticky; top: calc(var(--hdr-h) + 16px); } }

  .gal__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; border-radius: 20px; background: var(--light); scrollbar-width: none; }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__slide { flex: 0 0 100%; margin: 0; scroll-snap-align: start; aspect-ratio: 1; display: grid; place-items: center; padding: 6%; }
  .gal__slide img { max-height: 100%; width: auto; object-fit: contain; border-radius: 8px; box-shadow: 0 16px 30px -18px rgba(22,18,15,.5); }
  .gal__thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; scrollbar-width: none; }
  .gal__thumb { flex: 0 0 64px; height: 64px; border-radius: 12px; overflow: hidden; border: 2px solid transparent; background: var(--light); }
  .gal__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .gal__thumb.is-on { border-color: var(--red); }

  .box__badges { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 0.7rem; }
  .box__h { font-size: clamp(1.7rem, 6vw, 2.5rem); line-height: 1.08; margin-bottom: 0.3rem; }
  .box__rev { font-size: 0.85rem; color: var(--ink-soft); margin-bottom: 0.8rem; }
  .box__rev a { text-decoration: underline; }
  .box__short { font-size: 1.05rem; }
  .facts { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: 6px; }
  .facts li { font-family: var(--font-head); font-weight: 700; font-size: 0.8rem; padding: 0.35rem 0.7rem; border: 1.5px solid var(--ink); border-radius: 999px; }
  .box__price { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; margin: 0 0 0.9rem; }
  .box__price span { font-family: var(--font-head); font-weight: 900; font-size: 2.3rem; color: var(--ink); line-height: 1; }
  .box__price small { color: var(--ink-soft); font-weight: 700; }
  .trust { list-style: none; padding: 0; margin: 0.9rem 0 0.6rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .trust li { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; font-size: 0.76rem; font-weight: 700; background: var(--light); border-radius: 12px; padding: 10px 4px; }
  .trust li :global(svg) { color: var(--red); }
  .box__ship { display: flex; gap: 8px; align-items: flex-start; font-size: 0.88rem; font-weight: 700; background: var(--butter); border-radius: 12px; padding: 10px 12px; }
  .box__ship :global(svg) { flex: none; margin-top: 2px; }

  .acc { border-top: 1px solid var(--line); margin-top: 1rem; }
  .acc details { border-bottom: 1px solid var(--line); }
  .acc summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 0; font-family: var(--font-head); font-weight: 800; text-transform: uppercase; font-size: 0.9rem; letter-spacing: 0.03em; min-height: 48px; }
  .acc summary::-webkit-details-marker { display: none; }
  .acc summary :global(svg) { transition: transform .2s; flex: none; }
  .acc details[open] summary :global(svg) { transform: rotate(45deg); }
  .acc details > p, .acc details > ul { margin: 0 0 1rem; }
  .acc a { color: var(--red-text); text-decoration: underline; }
  .ticks { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .ticks li { display: flex; gap: 8px; align-items: flex-start; }
  .ticks li :global(svg) { flex: none; margin-top: 4px; color: #fff; background: var(--red); border-radius: 50%; padding: 2px; width: 18px; height: 18px; }
  .note { font-size: 0.9rem; background: var(--light); padding: 0.8rem 1rem; border-radius: 12px; margin-top: 1rem; }

  .ben { background: var(--ink); color: #fff; }
  .ben__row { list-style: none; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem 1rem; padding-top: 2rem; padding-bottom: 2rem; }
  @media (min-width: 900px) { .ben__row { grid-template-columns: repeat(4, 1fr); } }
  .ben__row li { display: flex; flex-direction: column; gap: 0.3rem; }
  .ben__ic { width: 44px; height: 44px; border-radius: 12px; background: var(--red); display: grid; place-items: center; margin-bottom: 0.3rem; }
  .ben__row b { font-family: var(--font-head); font-weight: 800; }
  .ben__row span:last-child { font-size: 0.88rem; color: #D8D2CE; }

  .display { font-size: clamp(1.9rem, 6.4vw, 2.8rem); }
  .look__row { scroll-padding-inline: 20px; display: grid; grid-auto-flow: column; grid-auto-columns: 70%; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; margin: 1.2rem -20px 0; padding: 0 20px 6px; scrollbar-width: none; }
  .look__row img { scroll-snap-align: start; border-radius: 12px; box-shadow: 0 10px 24px -14px rgba(22,18,15,.4); }
  @media (min-width: 800px) { .look__row { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); margin: 1.4rem 0 0; padding: 0; overflow: visible; } }

  .how {
    background-color: #FBFAFF;
    background-image: linear-gradient(#E8E6F4 1px, transparent 1px), linear-gradient(90deg, #E8E6F4 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .how__h { text-transform: uppercase; font-size: clamp(1.5rem, 4.4vw, 2.2rem); text-align: center; }
  .how__row { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 12px; }
  @media (min-width: 800px) { .how__row { grid-template-columns: repeat(3, 1fr); } }
  .how__step { background: #fff; border: 2px solid var(--red); padding: 16px 18px; }
  .how__n { display: block; font-family: var(--font-head); font-stretch: 75%; font-weight: 900; font-size: 2.4rem; line-height: 1; color: var(--red-text); margin-bottom: 0.4rem; }
  .how__step h3 { text-transform: uppercase; font-size: 1rem; margin-bottom: 0.3rem; }
  .how__step p { margin: 0; font-size: 0.95rem; }

  .revs__empty { border: 2px dashed var(--sand-2); border-radius: 18px; padding: 20px; margin-top: 1.2rem; max-width: 640px; }
  .revs__empty p:last-child { margin: 0; }
  .revs__empty a { color: var(--red-text); text-decoration: underline; }
  .faq { padding-top: 0; }
  .narrow { max-width: 760px; }

  .promise { background: var(--red-soft); }
  .promise__row { display: flex; gap: 16px; align-items: flex-start; padding-top: 2rem; padding-bottom: 2rem; }
  .promise__ic { width: 56px; height: 56px; flex: none; border-radius: 16px; background: var(--red); color: #fff; display: grid; place-items: center; }
  .promise__h { font-size: 1.4rem; text-transform: uppercase; margin-bottom: 0.3rem; }
  .promise p { margin: 0; }

  .rel__row { scroll-padding-inline: 20px; display: grid; grid-auto-flow: column; grid-auto-columns: 58%; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; margin: 1.2rem -20px 0; padding: 0 20px 6px; scrollbar-width: none; }
  @media (min-width: 800px) { .rel__row { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); margin: 1.4rem 0 0; padding: 0; } }
  .rel__card { scroll-snap-align: start; display: flex; flex-direction: column; gap: 0.4rem; }
  .rel__card img { border-radius: 14px; background: var(--light); transition: transform .2s; }
  .rel__card:hover img { transform: translateY(-3px); }
  .rel__name { font-family: var(--font-head); font-weight: 800; font-size: 0.95rem; line-height: 1.25; }
  .rel__price { font-family: var(--font-head); font-weight: 900; color: var(--red-text); }

  .sbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; background: #fff; border-top: 1px solid var(--line); box-shadow: 0 -10px 30px -18px rgba(22,18,15,.4); transform: translateY(110%); transition: transform .25s ease; padding-bottom: env(safe-area-inset-bottom); }
  .sbar.is-on { transform: none; }
  .sbar__in { max-width: var(--maxw); margin: 0 auto; display: flex; align-items: center; gap: 10px; padding: 10px 14px; }
  .sbar__in img { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; }
  .sbar__t { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.2; }
  .sbar__t b { font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sbar__t span { font-family: var(--font-head); font-weight: 900; color: var(--red-text); }
  .sbar__in :global(.btn) { padding: 0.7rem 1rem; font-size: 0.8rem; white-space: nowrap; }
  @media (min-width: 900px) { .sbar { display: none; } }
</style>
