---
import Base from '../../layouts/Base.astro';
import BuyButton from '../../components/BuyButton.astro';
import { products } from '../../data/products';

const faqs = [
  { q: 'Is this a printed book?', a: 'No. For now everything in the Blululu shop is a digital soft copy (PDF). Nothing is posted to you; you download it instantly and print at home or at any print shop.' },
  { q: 'How do I get it?', a: 'Straight after paying you get a download link on screen and by email. It is a PDF that works on any phone, tablet or computer.' },
  { q: 'Can I pay with UPI?', a: 'Yes. In India you can pay with UPI, RuPay or any card. Outside India, all major cards work.' },
  { q: 'Can I print it?', a: 'Yes. Print as many copies as your own family needs. Please don’t resell or share the file.' },
  { q: 'What if I don’t like it?', a: 'Email us within 7 days and we’ll refund you. See our refund policy.' },
];

const SITE = 'https://www.blubabyshow.com';
const jsonLd = [
  {
    '@type': 'FAQPage',
    '@id': `${SITE}/shop/#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE}/shop/#products`,
    name: 'Blululu Shop',
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE}/shop/${p.slug}/`,
      name: p.name,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Shop', item: `${SITE}/shop/` },
    ],
  },
];
---

<Base
  title="Shop · Printable PDFs for toddlers and parents | Blululu"
  description="Printable PDFs from Blu Baby Show: What to Say When Your Toddler Melts Down (₹49) and the Big Feelings Colouring Book (₹149). Instant download, nothing shipped. UPI accepted."
  jsonLd={jsonLd}
>
  <section class="shophead">
    <div class="wrap">
      <p class="eyebrow eyebrow--light">Blululu Originals</p>
      <h1 class="display shophead__h">The shop</h1>
      <p class="shophead__lead">Printables for the big little moments, starring Blu and his family. Instant PDF download. Nothing is shipped. Pay with UPI or card.</p>
    </div>
  </section>

  <section class="section shoplist">
    <div class="wrap grid">
      {products.map((p) => (
        <article class="card">
          <a href={`/shop/${p.slug}/`} class="card__art">
            <img src={p.img} alt={p.imgAlt} width="800" height="800" loading="lazy" decoding="async" />
          </a>
          <div class="card__badges"><span class="badge">{p.badge}</span><span class="badge badge--show">from BluBabyShow</span></div>
          <h2><a href={`/shop/${p.slug}/`}>{p.name.replace(' (PDF)', '')}</a></h2>
          <p class="muted">{p.short}</p>
          <p class="price"><span data-price-inr={p.inr} data-price-usd={p.usd}>₹{p.inr}</span> <small>{p.ages} · {p.pages} pages · PDF</small></p>
          <div class="card__cta">
            <BuyButton product={p} full />
            <a class="btn btn--ghost btn--block" href={`/shop/${p.slug}/`}>See inside</a>
          </div>
        </article>
      ))}
      <a class="card card--soon" href="/kits/">
        <span class="pill pill--w">Coming soon</span>
        <span class="display card__soon">Kits for big little moments</span>
        <span class="card__wait">Join the waitlist →</span>
      </a>
    </div>
  </section>

  <section class="section faq">
    <div class="wrap narrow">
      <h2>Questions parents ask</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}{f.q.startsWith('What if') && <> <a href="/refund">Refund policy</a>.</>}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .shophead { background: var(--red); color: #fff; padding: 2.4rem 0 2.2rem; }
  .shophead__h { color: #fff; font-size: clamp(2.6rem, 11vw, 5rem); margin-bottom: 0.3em; }
  .shophead__lead { font-weight: 600; max-width: 48ch; margin: 0; }
  .grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .card { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 16px; display: flex; flex-direction: column; gap: 0.5rem; }
  .card__art { display: block; border-radius: 14px; background: var(--light); overflow: hidden; }
  .card__art img { transition: transform .25s; }
  .card__art:hover img { transform: scale(1.03); }
  .card__badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 0.4rem; }
  .card h2 { font-size: 1.35rem; margin: 0.2rem 0 0; line-height: 1.15; }
  .card p { margin: 0; }
  .price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-top: auto !important; padding-top: 0.4rem; }
  .price span { font-family: var(--font-head); font-size: 1.9rem; font-weight: 900; }
  .price small { font-size: 0.85rem; color: var(--ink-soft); font-weight: 700; }
  .card__cta { display: grid; gap: 8px; }
  .card--soon { background: var(--ink); color: #fff; border: 0; justify-content: flex-end; min-height: 240px; padding: 24px; }
  .card--soon .pill--w { background: #fff; color: var(--ink); align-self: flex-start; margin-bottom: auto; }
  .card__soon { color: #fff; font-size: 2rem; }
  .card__wait { font-weight: 800; color: #FF8FA6; }
  .narrow { max-width: 760px; }
  .faq { padding-top: 0; }
  .faq h2 { margin-bottom: 1rem; }
  details { border-bottom: 1px solid var(--line); padding: 1rem 0; }
  summary { font-family: var(--font-head); font-weight: 800; font-size: 1rem; cursor: pointer; }
  details p { margin: 0.7rem 0 0; }
  details a { color: var(--red-text); text-decoration: underline; }
</style>
