---
import Base from '../../layouts/Base.astro';
import BuyButton from '../../components/BuyButton.astro';
import Doodles from '../../components/Doodles.astro';
import { products } from '../../data/products';

const faqs = [
  { q: 'Is this a printed book?', a: 'No. For now everything in the Blu Shop is a digital soft copy (PDF). Nothing is posted to you; you download it instantly and print at home or at any print shop.' },
  { q: 'How do I get it?', a: 'Straight after paying you get a download link on screen and by email. It is a PDF that works on any phone, tablet or computer.' },
  { q: 'Can I pay with UPI?', a: 'Yes. In India you can pay with UPI, RuPay or any card. Outside India, all major cards work.' },
  { q: 'Can I print it?', a: 'Yes. Print as many copies as your own family needs. Please don’t resell or share the file.' },
  { q: 'What if I don’t like it?', a: 'Email us within 7 days and we’ll refund you. See our refund policy.' },
];
---

<Base
  title="The Blu Shop · Printables for little ones"
  description="Friendly printables from Blu Baby Show: the Baby Dos & Don'ts guide and the Big Feelings Colouring Book. Instant PDF download, UPI accepted."
>
  <section class="section shophead section--center">
    <Doodles variant="hero" />
    <div class="wrap">
      <p class="eyebrow">The Blu Shop</p>
      <h1>Little helpers for<br />big days with little ones</h1>
      <p class="muted lead">Made by the team behind Blu, watched 92M+ times. Digital downloads (PDF soft copies) only; nothing is shipped. Pay with UPI.</p>
    </div>
  </section>

  <section class="section shoplist">
    <div class="wrap grid">
      {products.map((p) => (
        <article class="card" style={`--c:${p.accent}`}>
          <span class="badge">{p.badge}</span>
          <a href={`/shop/${p.slug}`} class="card__art">
            <img class="sticker" src={p.img} alt={p.imgAlt} width="260" height="260" loading="lazy" decoding="async" />
          </a>
          <h2><a href={`/shop/${p.slug}`}>{p.name}</a></h2>
          <p class="muted">{p.short}</p>
          <p class="price"><span data-price-inr={p.inr} data-price-usd={p.usd}>₹{p.inr}</span> <small>· PDF soft copy</small></p>
          <div class="card__cta">
            <BuyButton product={p} />
            <a class="btn btn--ghost" href={`/shop/${p.slug}`}>See inside</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section faq">
    <div class="wrap narrow">
      <h2>Questions parents ask</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}{f.q.startsWith('What if') && <> <a href="/refund">Refund policy</a>.</>}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .shophead { padding-top: calc(var(--nav-h) + 3rem); padding-bottom: 1rem; overflow: hidden; }
  .shophead .lead { font-size: 1.15rem; max-width: 46ch; margin: 0 auto; }
  .shoplist { padding-top: 2rem; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .card {
    position: relative; background: var(--paper); border-radius: var(--radius);
    padding: 2rem; box-shadow: var(--shadow-soft); border-top: 10px solid var(--c);
    display: flex; flex-direction: column;
  }
  .badge {
    position: absolute; top: 1.2rem; right: 1.2rem; background: var(--c); color: #fff;
    font-family: var(--font-head); font-weight: 600; font-size: 0.85rem; padding: 0.3rem 0.8rem; border-radius: 999px;
  }
  .card__art { display: block; width: 220px; margin: 0 auto 1rem; }
  .card h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .price { font-family: var(--font-head); font-size: 2rem; font-weight: 700; color: var(--blu-deep); margin-top: auto; }
  .price small { font-size: 1rem; color: var(--ink-soft); font-weight: 500; }
  .card__cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .narrow { max-width: 720px; }
  .faq h2 { text-align: center; margin-bottom: 1.5rem; }
  details { background: var(--paper); border-radius: var(--radius-sm); padding: 1rem 1.3rem; margin-bottom: 0.8rem; box-shadow: var(--shadow-soft); }
  summary { font-family: var(--font-head); font-weight: 600; font-size: 1.1rem; cursor: pointer; color: var(--blu-deep); }
  details p { margin: 0.7rem 0 0; }
  details a { color: var(--blu-d); text-decoration: underline; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; }
    .card { padding: 1.5rem; }
  }
</style>
